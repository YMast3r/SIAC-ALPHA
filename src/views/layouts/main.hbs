<!DOCTYPE html>
<html lang="es">

<head>
    <!-- Codificación del documento y ajuste de la escala para dispositivos móviles -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Título de la página -->
    <title>SIAC</title>
    <!-- Enlace a la hoja de estilos de Tailwind CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.0.1/tailwind.min.css">
    <!-- Enlace a Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    {{!-- LIBRERIAS --}}
    <link href="/select2/css/select2.min.css" rel="stylesheet" />
    <script src="/jquery/jquery.min.js"></script>
    <script src="/select2/js/select2.min.js"></script>
</head>

<body class="bg-gray-200"> <!-- Fondo de la página -->
    <div>

        <!-- Barra de navegación -->
        <nav class="bg-gray-500 flex items-center justify-between px-4 sm:px-10 py-2">
            <!-- Logotipo y título -->
            <div class="flex items-center">
                <!-- Ajuste del tamaño del logotipo para dispositivos móviles -->
                <a href="/">
                    <img style="height: 60px;" src="imagenes/logo.png"
                        class="object-cover 2xl:h-40 2xl:w-auto 2xl:mr-10 md:h-20 md:w-auto sm:h-20 sm:w-auto sm:mr-1 mr-4"
                        alt="Logo">
                </a>
                <a href="/">
                    <!-- Ajuste del tamaño del título para dispositivos móviles -->
                    <h1 class="px-2 text-xl font-bold text-white sm:block">SIAC</h1>
                </a>
            </div>

            <!-- Menú de navegación -->
            <div class="flex items-center space-x-4">
                <ul class="text-white flex items-center overflow-x-auto md:overflow-x-visible space-x-2">
                    {{#if name}}
                    <!-- Comprobación si hay un usuario logueado -->
                    {{#isEqual tipoUsuario 1}}
                    <li class="px-2 sm:px-4">
                        <a id="renderAdm" href="/renderAdm"
                            class="font-semibold border-2 border-white hover:bg-white hover:text-gray-900 py-2 px-4 rounded-md text-xs sm:text-sm mb-2 sm:mb-0"
                            role="menuitem">Administradores</a>
                    </li>
                    <li class="px-2 sm:px-4">
                        <a id="renderEmpleados" href="/renderEmpleados"
                            class="font-semibold border-2 border-white hover:bg-white hover:text-gray-900 py-2 px-4 rounded-md text-xs sm:text-sm mb-2 sm:mb-0">Empleados</a>
                    </li>
                    {{/isEqual}}
                    {{#isEqual tipoUsuario 2}}
                    <li class="px-2 sm:px-4">
                        <a id="renderEmpleados" href="/renderEmpleados"
                            class="font-semibold border-2 border-white hover:bg-white hover:text-gray-900 py-2 px-4 rounded-md text-xs sm:text-sm mb-2 sm:mb-0">Empleados</a>
                    </li>
                    <li class="px-2 sm:px-4">
                        <a id="renderHistorial" href="/renderHistorial"
                            class="font-semibold border-2 border-white hover:bg-white hover:text-gray-900 py-2 px-4 rounded-md text-xs sm:text-sm mb-2 sm:mb-0">Historial</a>
                    </li>
                    <li class="px-2 sm:px-4">
                        <a id="renderManCondomino" href="/renderManCondomino"
                            class="font-semibold border-2 border-white hover:bg-white hover:text-gray-900 py-2 px-4 rounded-md text-xs sm:text-sm mb-2 sm:mb-0">Condóminos</a>
                    </li>
                    <li class="px-2 sm:px-4">
                        <a id="renderManPropiedad" href="/renderManPropiedad"
                            class="font-semibold border-2 border-white hover:bg-white hover:text-gray-900 py-2 px-4 rounded-md text-xs sm:text-sm mb-2 sm:mb-0">Propiedades</a>
                    </li>
                    <li class="px-2 sm:px-4">
                        <a id="manPaginaTipo" href='/manPaginaTipo'
                            class="font-semibold border-2 border-white hover:bg-white hover:text-gray-900 py-2 px-4 rounded-md text-xs sm:text-sm mb-2 sm:mb-0">Tipos</a>
                    </li>
                    {{/isEqual}}
                    {{#isEqual tipoUsuario 3}}
                    <li class="px-2 sm:px-4">
                        <a id="manIncidencia-{{id}}" href='/manIncidencia-{{id}}'
                            class="font-semibold border-2 border-white hover:bg-white hover:text-gray-900 py-2 px-4 rounded-md text-xs sm:text-sm mb-2 sm:mb-0">Incidencia</a>
                    </li>
                    <li class="px-2 sm:px-4">
                        <a id="recuperarPropiedadPago-{{id}}" href='/recuperarPropiedadPago-{{id}}'
                            class="font-semibold border-2 border-white hover:bg-white hover:text-gray-900 py-2 px-4 rounded-md text-xs sm:text-sm mb-2 sm:mb-0">Pagos</a>
                    </li>
                    {{/isEqual}}
                </ul>
                <div class="relative inline-block text-left z-20">
                    <div>
                        <button id="dropdownUserAvatarButton" onclick="toggleDropdown()"
                            class="flex text-sm bg-gray-800 rounded-full md:me-0" type="button">
                            <span class="sr-only">Open user menu</span>
                            <img class="w-9 h-9 rounded-full object-cover" src="imagenes/Perfil_sin_foto.png" alt="user photo">
                        </button>
                    </div>

                    <!-- Dropdown menu -->
                    <div id="dropdownAvatar"
                        class="hidden origin-top-right absolute right-0 mt-2 w-44 rounded-md shadow-lg bg-white z-20">
                        <div class="py-1" role="menu" aria-orientation="vertical"
                            aria-labelledby="dropdownUserAvatarButton">
                            <p class="italic text-center block px-4 py-2 text-sm text-gray-900 font-semibold">{{name}}</p>
                            <a href="/desconectarse"
                                class="block px-4 py-2 text-sm text-gray-700 hover:bg-red-500 hover:text-white hover:px-5 hover:py-3 hover:text-md ease-in duration-200"
                                role="menuitem">Salir</a>

                            <!-- Opciones de inicio de sesión y registro para usuarios no logueados -->
                            {{else}}
                            <li class="px-2 sm:px-4">
                                <!-- Ajuste del tamaño del botón de acceso para dispositivos móviles -->
                                <a href="/ingreso"
                                    class="font-semibold border-2 border-white hover:bg-white hover:text-gray-900 py-2 px-4 rounded-md text-xs sm:text-sm mb-2 sm:mb-0">Ingresar</a>
                            </li>
                            <li class="px-2 sm:px-4">
                                <!-- Ajuste del tamaño del botón de registro para dispositivos móviles -->
                                <a href="/registro"
                                    class="font-semibold border-2 border-white hover:bg-white hover:text-gray-900 py-2 px-4 rounded-md text-xs sm:text-sm mb-2 sm:mb-0">Registrarse</a>
                            </li>
                            {{#if acceder}}
                            <li class="px-2 sm:px-4">
                                <!-- Ajuste del tamaño del botón de registro para dispositivos móviles -->
                                <a href="/ingresoA"
                                    class="font-semibold border-2 border-white hover:bg-white hover:text-gray-900 py-2 px-4 rounded-md text-xs sm:text-sm mb-2 sm:mb-0">
                                    <i class="fa-solid fa-hippo"></i><i class="fa-solid fa-dragon"></i><i class="fa-solid fa-spider"></i>
                                    AUTO
                                    <i class="fa-solid fa-cat"></i><i class="fa-solid fa-dog"></i><i class="fa-solid fa-fish"></i>
                                </a>
                            </li>
                            <br>
                            <li class="px-2 sm:px-4">
                                <!-- Ajuste del tamaño del botón de registro para dispositivos móviles -->
                                <a href="/ingresoAP"
                                    class="font-semibold border-2 border-white hover:bg-white hover:text-gray-900 py-2 px-4 rounded-md text-xs sm:text-sm mb-2 sm:mb-0">Automático pagos</a>
                            </li>
                            <li class="px-2 sm:px-4">
                                <!-- Ajuste del tamaño del botón de registro para dispositivos móviles -->
                                <a href="/ingresoAS"
                                    class="font-semibold border-2 border-white hover:bg-white hover:text-gray-900 py-2 px-4 rounded-md text-xs sm:text-sm mb-2 sm:mb-0">Automático seguimiento</a>
                            </li>
                            {{/if}}
                            {{/if}}
                        </div>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Contenido dinámico generado por la aplicación -->
        {{{body}}}

        <button onclick="window.history.back()"
            class="fixed bottom-0 left-0 ml-4 text-black font-medium py-6 px-4 rounded text-2xl">
            <i class="fas fa-arrow-left"></i> Volver
        </button>
    </div>
    <script>
        function toggleDropdown() {
            document.getElementById('dropdownAvatar').classList.toggle('hidden');
        }
    </script>
</body>


</html>