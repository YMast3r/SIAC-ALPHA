{{#if name}}
<!DOCTYPE html>
<html lang="es">

<head>
    <script src="https://cdn.tailwindcss.com"></script><!-- sirve para usar tailwind -->
    <link href="/select2/css/select2.min.css" rel="stylesheet" />
    <script src="/jquery/jquery.min.js"></script>
    <script src="/select2/js/select2.min.js"></script>
</head>

<body class="bg-indigo-300">

    <!-- Sección de Datos -->
    <div>
        <a href="/renderIncidencia">
            <h1 class="font-semibold text-4xl hover:text-gray-400 flex justify-center m-5">Incidencia</h1>
        </a>
        <div class="flex justify-center m-5 ">
            <div class="overflow-x-auto max-h-60 border-2 border-gray-300 rounded-lg shadow-lg">
                <table class="w-full rounded-lg overflow-hidden">
                    <thead>
                        <tr>
                            <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-center text-2xl font-medium rounded-tl-lg">Id</th>
                            <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-center text-2xl font-medium">Nombre</th>
                            <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-center text-2xl font-medium">Correo</th>
                            <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-center text-2xl font-medium">Teléfono</th>
                            <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-center text-2xl font-medium rounded-tr-lg">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each usuario}}
                        <tr>
                            <td class="px-4 py-2 bg-white text-center text-lg border-b-2 border-gray-200">{{this.id}}</td>
                            <td class="px-4 py-2 bg-white text-center text-lg border-b-2 border-gray-200">{{this.nombre}}</td>
                            <td class="px-4 py-2 bg-white text-center text-lg border-b-2 border-gray-200">{{this.correo_electronico}}</td>
                            <td class="px-4 py-2 bg-white text-center text-lg border-b-2 border-gray-200">{{this.telefono}}</td>
                            <td class="px-4 py-2 bg-white text-center text-lg border-b-2 border-gray-200">{{this.status}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {{#if errorDatos}}
    <center>
        <h1 class="font-semibold text-4xl flex justify-center m-5">No hay incidencias registrados</h1>
    </center>
    {{else}}
    <!-- Sección de Incidencias -->
    <div class="flex flex-col items-center mt-4 pt-5">
        <div class="relative w-9/12 mb-0 ">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3">
                <i class="fas fa-search text-gray-500"></i> <!-- Ícono de lupa -->
            </span>
            <input type="text" id="buscarAsunto" onkeyup="filtrarTabla()" placeholder="Buscar por asunto"
                class=" bg-white border border-gray-200 text-lg placeholder-gray-500 p-2 focus:bg-white hover:bg-gray-300 w-full rounded-lg pl-10">
        </div>

    <div class="flex justify-center w-9/12 mx-auto "> 
        <div class="overflow-x-auto rounded-lg mb-10 w-full max-h-60">
                <table class="w-full " id="tablaIncidencias">
                <thead class="sticky top-0">
                    <tr>
                        <th id="contenedorFlecha" style="cursor: pointer;" class="px-4 bg-white border-b-2 border-gray-400 text-2xl font-medium rounded-tl-lg ">
                            <span class="inline-flex items-center space-x-1">
                                <p> Folio </p>
                                {{!-- &nbsp; --}}
                                <a href="#" id="flechaDesc" data-order="desc">&darr;</a>
                                <a href="#" id="flechaAsc" data-order="asc">&uarr;</a>
                            </span>
                        </th>
                        <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-2xl text-center font-medium">Asunto</th>
                        <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-2xl text-center font-medium">
                            Tipo
                            Clasificación
                        </th>
                        <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-2xl text-center font-medium">Status</th>
                        <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-2xl text-center font-medium">Fecha</th>
                        <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-2xl text-center font-medium">Hora</th>
                        <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-2xl text-center font-medium">Evidencia</th>
                        <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-2xl text-center font-medium rounded-tr-lg"> </th>
                    </tr>
                </thead>
                <tbody id="tablaIncidenciaBody">
                    {{#each datos}}
                    <tr>
                        <td class="px-4 py-2 bg-white text-center border-b-2 border-gray-200 shadow-b-xl">{{this.folio}}
                        </td>
                        <td class="px-4 py-2 bg-white border-b-2 border-gray-200 text-lg text-center shadow-b-xl text-center">
                            {{this.asunto}}</td>
                        <td class="px-4 py-2 bg-white border-b-2 border-gray-200 text-lg text-center shadow-b-xl">
                            {{this.tipo}},
                            <br>
                            {{this.clasificacion}},
                        </td>
                        <td class="px-4 py-2 bg-white border-b-2 border-gray-200 text-lg text-center shadow-b-xl">{{this.status}}</td>
                        <td class="px-4 py-2 bg-white border-b-2 border-gray-200 text-lg text-center shadow-b-xl">{{this.fecha}}</td>
                        <td class="px-4 py-2 bg-white border-b-2 border-gray-200 text-lg text-center shadow-b-xl">{{this.hora}}</td>
                        <td class="px-4 py-2 bg-white border-b-2 border-gray-200 text-lg text-center shadow-r-xl border-br-lg">
                            {{#if this.evidencia}}
                            <img src="{{this.evidencia}}" alt="Evidencia"
                                class="w-20 h-20 object-cover rounded-sm text-lg text-center shadow-l-lg mx-auto" onclick="mostrarImagen(this.src)">
                            {{else}}
                            {{!-- <i class="fas fa-image" style="position: relative;">
                            <i class="fas fa-ban" style="position: absolute; top: -5px; left: -5px; font-size: 1.5em; color: rgb(59, 59, 59);"></i>
                            </i> --}}
                            <div class="w-20 h-20 object-cover rounded-sm text-lg text-center shadow-l-lg mx-auto" >
                                <img src="/imagenes/sinImagen.png" alt="Sin evidencia">
                            </div>
                            

                            {{/if}}
                        </td>
                        <td class="px-4 py-2 bg-white text-center border-b-2 border-gray-200">
                            <a id="{{this.folio}}" href="/manSeguimiento-{{this.folio}}"
                                class="px-4 py-2 text-white bg-gray-600 border-gray-400 font-medium rounded-md">Detalle</a>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
    {{/if}}

    <div class="text-2xl flex justify-center">
        <h1 class="font-semibold text-4xl flex justify-center ">Alta</h1>
    </div>
    <!-- Formulario para agregar incidencia -->
    <div class="mx-auto text-lg my-8 p-4 bg-white w-full sm:w-5/6 md:w-4/6 lg:w-2/3 xl:w-1/3 border rounded-lg shadow-lg">
        <form action="/altaIncidencia" method="POST" enctype="multipart/form-data">
            <label for="asunto">
                <i class="fas fa-bullhorn"></i>
                Asunto</label>
            <input type="text" id="asunto" name="asunto" required placeholder="Asunto" required 
                class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">

            <label for="descripcion">                                            
                <i class="fas fa-clipboard-list">&nbsp;</i>Incidencia</label>
            <br>
            <textarea name="descripcion" id="descripcion" placeholder="Incidencia" required
                class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10"></textarea>
            <br>

            <label for="tipo">
                <i class="fas fa-clipboard-list"></i>
                Tipo de Incidencia</label>
                <br>
            <select id="tipo" name="tipo" required
                class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                <option selected value="">Todos</option>
                {{#each tipos}}
                <option value="{{this.id_tipo_incidencia}}">{{this.descripcion}}</option>
                {{/each}}
            </select>

            <label for="clasificacion">
                <i class="fa-solid fa-list"></i>
                Clasificación</label>
            <select id="clasificacion" name="clasificacion" required
                class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                <option selected value="">Todas</option>
                {{#each clasificacionLista}}
                <option value="{{this.id_clasificacion_incidencia}}">{{this.descripcion}}</option>
                {{/each}}
            </select>

            <label for="fecha"><i class="fas fa-calendar"></i> Fecha</label>
            <input type="date" id="fecha" name="fecha" required
                class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">

            <label for="hora"><i class="fas fa-calendar"></i> Hora</label>
            <input type="time" id="hora" name="hora"
                class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">

            <label for="imagen"><i class="fas fa-image"></i> Subir imagen</label>
            <input type="file" id="imagen" name="imagen" accept=".png, .jpg, .jpeg, .pdf"
                class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">

            <div class="flex justify-center">
                <button id="enviar" type="submit"
                    class="px-4 py-2 text-white bg-gray-600 border-gray-400 font-medium rounded-md">Agregar
                    Incidencia</button>
            </div>

            <!--Sección para mostrar errores-->
            {{#if error}}
            <p class="text-red-500 font-bold text-lg my-3">*{{{error}}}</p>
            {{/if}}

        </form>
        <script>
            // Mostrar alerta si hay un mensaje de error
            const errorMessage = '{{error}}'; // Aquí se pasa el mensaje de error desde el backend
            if (errorMessage) {
                alert(errorMessage);
            }
        </script>
    </div>
    </div>
    <script src="fecha.js"></script>
    <script>
        // Abre una nueva ventana con la imagen en tamaño completo
        function mostrarImagen(src) {
            window.open(src, "_blank");
        }

        document.getElementById("buscarAsunto").addEventListener("input", function (event) {
            let valor = event.target.value;
            // Permitir solo letras, números y espacios
            event.target.value = valor.replace(/[^a-zA-Z0-9 ]/g, '');
        });

        function filtrarTabla() {
            let input = document.getElementById("buscarAsunto");
            let filtro = input.value.toLowerCase();
            let tabla = document.getElementById("tablaIncidencias");
            let filas = tabla.getElementsByTagName("tr");

            // Elimina cualquier mensaje anterior de "No se encontró ningún asunto"
            let filasNoEncontrado = tabla.querySelectorAll(".fila-no-encontrado");
            filasNoEncontrado.forEach(fila => fila.remove());

            let encontrado = false;

            for (let i = 1; i < filas.length; i++) {
                let celdaAsunto = filas[i].getElementsByTagName("td")[1];
                if (celdaAsunto) {
                    let asuntoTexto = celdaAsunto.textContent || celdaAsunto.innerText;
                    if (asuntoTexto.toLowerCase().indexOf(filtro) > -1) {
                        filas[i].style.display = "";
                        encontrado = true;
                    } else {
                        filas[i].style.display = "none";
                    }
                }
            }

            if (!encontrado) {
                let filaNoEncontrado = document.createElement("tr");
                filaNoEncontrado.className = "fila-no-encontrado"; // Clase identificadora
                let celda = document.createElement("td");
                celda.colSpan = 7;
                celda.className = "px-4 py-4 bg-white text-center font-normal rounded text-lg";
                celda.textContent = "No se encontró ningún asunto";
                filaNoEncontrado.appendChild(celda);
                tabla.getElementsByTagName("tbody")[0].appendChild(filaNoEncontrado);
            }
        }

        //flechita para el folio
        document.getElementById('contenedorFlecha').addEventListener('click', function (event) {
            event.preventDefault();

            // flechas
            let abajo = document.getElementById('flechaDesc');
            let arriba = document.getElementById('flechaAsc');

            let orden; // Definir la variable "orden"

            // Verificar si está en descendente
            if (abajo.getAttribute('data-order') === 'desc') {
                // Cambio a orden ascendente
                abajo.innerHTML = '&uarr;';
                abajo.setAttribute('data-order', 'asc');
                orden = 'asc'; // Cambiar el valor de "orden"

                // Cambiar arriba a descendente
                arriba.innerHTML = '&darr;';
                arriba.setAttribute('data-order', 'desc');
            } else {
                // Cambio a orden descendente
                abajo.innerHTML = '&darr;';
                abajo.setAttribute('data-order', 'desc');
                orden = 'desc'; // Cambiar el valor de "orden"

                // Cambiar arriba a ascendente
                arriba.innerHTML = '&uarr;';
                arriba.setAttribute('data-order', 'asc');
            }

            let tbody = document.getElementById('tablaIncidenciaBody');
            let filas = Array.from(tbody.getElementsByTagName('tr'));

            // Ordenar las filas en base a la primera columna (FOLIO)
            filas.sort(function (a, b) {
                let valorA = a.getElementsByTagName('td')[0].innerText;
                let valorB = b.getElementsByTagName('td')[0].innerText;

                if (orden === 'asc') {
                    return valorA.localeCompare(valorB, undefined, { numeric: true });
                } else {
                    return valorB.localeCompare(valorA, undefined, { numeric: true });
                }
            });

            // Limpiar el tbody y agregar las filas ordenadas
            tbody.innerHTML = '';
            filas.forEach(function (fila) {
                tbody.appendChild(fila);
            });
        });
    </script>
    
    <script>
        $(document).ready(function () {
            // Inicializamos Select2 en todos los selects
            $('#tipo').select2({
                placeholder: "Seleccione un tipo incidencia",
                allowClear: true,
                language: {
                    noResults: function () {
                        return "No se encontraron resultados";
                    }
                }
            });

            $('#clasificacion').select2({
                placeholder: "Seleccione una clasificación",
                allowClear: true,
                language: {
                    noResults: function () {
                        return "No se encontraron resultados";
                    }
                }
            });


            // Deshabilitar inicialmente los selects de clasificación
            $('#clasificacion').prop('disabled', true);

            // Detectar el evento 'change' de Select2 para 'tipo'
            $('#tipo').on('change', function () {
                const selectedTipo = $(this).val(); // Obtener el valor seleccionado

                const clasificaciones = [
                    {{#each clasificacionLista}}
                        { id: "{{this.id_clasificacion_incidencia}}", nombre: "{{this.descripcion}}", tipo: "{{this.tipo_incidencia}}" },
                    {{/each}}
                ];

                const clasificacionSelect = $('#clasificacion');
                clasificacionSelect.empty(); // Limpiar las opciones del select de clasificación
                clasificacionSelect.append('<option value="" selected></option>'); // Agregar opción vacía

                if (selectedTipo) {
                    // Filtrar las clasificaciones según el tipo seleccionado
                    const filteredClasificaciones = clasificaciones.filter(emp => emp.tipo === selectedTipo);

                    // Agregar las opciones filtradas al select de clasificación
                    filteredClasificaciones.forEach(emp => {
                        const option = $('<option></option>').val(emp.id).text(emp.nombre);
                        clasificacionSelect.append(option);
                    });

                    // Habilitar el select de clasificación
                    clasificacionSelect.prop('disabled', false);
                } else {
                    // Deshabilitar el select de clasificación si no hay tipo seleccionado
                    clasificacionSelect.prop('disabled', true);
                }
            });
        });
    </script>

<style>
    /* Ajustes de altura */
    .select2-container--default .select2-selection--single {
        height: 3rem; /* Ajusta este valor según el tamaño que quieras */
        display: flex;
        align-items: center; /* Centra el texto verticalmente */
        position: relative; /* Posición relativa para manejar la x */
    }
    .select2-container .select2-selection--single .select2-selection__rendered {
        line-height: 3rem; /* Ajusta este valor al mismo valor que el height */
    }
    .select2-container .select2-selection--single .select2-selection__arrow {
        height: 3rem; /* Ajusta el ícono del desplegable */
    }
    /* Mover la X al lado derecho */
    .select2-container--default .select2-selection--single .select2-selection__clear {
        position: absolute;
        right: 10px; /* Ajusta la distancia del borde derecho */
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer; /* Cambia el cursor a pointer para mayor claridad */
    }
</style>
    <script src="imagen.js"></script>
</body>

</html>
{{else}}
<div style="display: flex; justify-content: center; align-items: center; height: 100vh;">
    <h1 style="font-size: 3em;">La sesión ha expirado. Por favor, inicie la sesión nuevamente.</h1>
</div>
{{/if}}