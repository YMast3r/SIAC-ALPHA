    <script defer>
        function handleTipoPagoChange(selectElement, precioInputId, recargoInputId, recargoContainerId, mensajeId) {
            let recargoInput = document.getElementById(recargoInputId);
            let contenedorInput = document.getElementById(recargoContainerId);
            let mensaje = document.getElementById(mensajeId);

            let selectedOption = selectElement.options[selectElement.selectedIndex];
            
            // Capturamos los valores de los atributos data-*
            let precio = selectedOption.getAttribute('data-precio') || selectedOption.getAttribute('data-precioPago');
            let cuota = selectedOption.getAttribute('data-cuota') || selectedOption.getAttribute('data-cuotaPago');
            let recargoPago = selectedOption.getAttribute('data-recargoPago') || selectedOption.getAttribute('data-recargoPago');
            let meses = parseInt(selectedOption.getAttribute('data-meses')) || parseInt(selectedOption.getAttribute('data-meses'));
            let fechaR = selectedOption.getAttribute('data-fechaR') || selectedOption.getAttribute('data-fechaR');
            let mes = selectedOption.getAttribute('data-mes') || '';
            let year = selectedOption.getAttribute('data-year') || '';
            let cuotaPago = selectedOption.getAttribute('data-cuotaPago') || '';

            // Asignamos estos valores a los campos ocultos (agregados para tipoPagoPlazo)
            document.getElementById('importeVarios').value = precio ? precio : '';
            document.getElementById('recargoPagoVarios').value = recargoPago ? recargoPago : '';
            document.getElementById('mesesVarios').value = meses ? meses : '';
            document.getElementById('fechaRVarios').value = fechaR ? fechaR : '';
            document.getElementById('mesVarios').value = mes ? mes : '';
            document.getElementById('yearVarios').value = year ? year : '';

            // Asignamos los valores a los campos visibles
            document.getElementById('importe').value = precio ? precio : '';
            document.getElementById('recargoPago').value = recargoPago ? recargoPago : '';
            document.getElementById('meses').value = meses ? meses : '';
            document.getElementById('fechaR').value = fechaR ? fechaR : '';
            document.getElementById('mes').value = mes ? mes : '';
            document.getElementById('year').value = year ? year : '';

            // Mostrar el precio correspondiente o limpiar el campo si no hay precio definido
            let precioInput = document.getElementById(precioInputId);
            precioInput.value = precio ? "$" + precio + ".00" : '';
            mensaje.innerHTML = '<i class="fas fa-money-bill-alt"></i> Monto';

            // Si hay meses por pagar, se muestra el recargo y el contenedor
            if (meses > 0) {
                contenedorInput.style.display = '';
                recargoInput.value = "Recargo por mes de: $" + recargoPago + ".00 por: " + meses + " meses, desde la fecha: " + fechaR;
            } else {
                contenedorInput.style.display = 'none';
            }
        }

        // Escuchar cambios en el select de tipoPago
        document.getElementById('tipoPago').addEventListener('change', function () {
            handleTipoPagoChange(this, 'precioPago', 'recargo', 'recargoContainer', 'mensajePago');
        });

        // Escuchar cambios en el select de tipoPagoPlazo
        document.getElementById('tipoPagoPlazo').addEventListener('change', function () {
            handleTipoPagoChange(this, 'precio', 'recargoPlazo', 'recargoPlazoContainer', 'mensajePagoPlazo');
        });
    </script>

    <script defer>
        // Obtener los elementos de entrada por su ID
        const reciboFolio = document.getElementById('reciboFolio');
        // Obtener los elementos de entrada por su ID
        const reciboFolioPlazo = document.getElementById('reciboFolioPlazo');
        // Obtener los elementos de entrada por su ID
        const filtroAño = document.getElementById('filtroAño');

        // Función para validar que el input sea un número entero positivo
        function validarInput(input) {
            input.addEventListener('input', function () {
                // Remover caracteres no numéricos utilizando una expresión regular
                let valor = input.value.replace(/\D/g, '');
                // Asignar el valor limpio al campo de entrada
                input.value = valor;
            });
        }

        validarInput(reciboFolio);
        validarInput(reciboFolioPlazo);
        validarInput(filtroAño);
    </script>

    <script defer>
        // Abre una nueva ventana con la imagen en tamaño completo
        function mostrarImagen(src) {
            window.open(src, "_blank");
        }
        // Obtener los elementos de entrada por su ID
        const recargoInputPlazo = document.getElementById('recargoPlazo');

        function validarEntrada(event) {
            const regex = /^[a-zA-Z0-9\s]*$/;
            if (!regex.test(event.target.value)) {
                event.target.value = event.target.value.replace(/[^a-zA-Z0-9\s]/g, '');
            }
        }

        document.getElementById('referencia').addEventListener('input', validarEntrada);
        document.getElementById('referenciaPlazo').addEventListener('input', validarEntrada);

        // Función para validar que el input sea un número con hasta dos decimales
        function validarInputF(input) {
            input.value = '0.00';
            input.addEventListener('input', function () {

                let value = input.value.replace(/\D/g, ''); // Eliminar cualquier carácter que no sea un dígito
                let floatValue = (parseFloat(value) / 100).toFixed(2); // Convertir a decimal (dos decimales)

                // Si no hay valor, establece el valor inicial
                if (value === '') {
                    input.value = '0.00';
                    return;
                }

                // Aplicar formato de número con comas
                let formattedValue = floatValue.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");

                input.value = formattedValue;
            });

        }
        validarInputF(recargoInputPlazo);

        // Función para mostrar una sección y ocultar las demás
        function mostrarSeccion(seccion) {
            // Ocultar todas las secciones
            document.getElementById('pagos').classList.add('hidden');
            document.getElementById('pagos_plazos').classList.add('hidden');
            document.getElementById('info').classList.add('hidden');

            // Mostrar solo la sección seleccionada
            document.getElementById(seccion).classList.remove('hidden');
        }
    </script>
    <!--Filtro fecha y mes-->
    <script defer>
        document.addEventListener("DOMContentLoaded", function () {
            const mesFiltro = document.getElementById("mesFiltro");
            const añoFiltro = document.getElementById("filtroAño");
            const tipoFiltro = document.getElementById("tipoFiltro");
            const tablaPagos = document.getElementById("tablaPagos");
            const mensajeNoResultados = document.getElementById("mensajeNoResultados");
            const filas = tablaPagos.getElementsByTagName("tr");

            function filtrarTabla() {
                const mes = mesFiltro.value.toLowerCase();
                const año = añoFiltro.value.toLowerCase();
                const tipo = tipoFiltro.value.toLowerCase();

                for (let i = 1; i < filas.length; i++) {
                    const fila = filas[i];
                    const celdaMes = fila.cells[2].textContent.toLowerCase();
                    const celdaAño = fila.cells[1].textContent.toLowerCase();
                    const celdaTipo = fila.cells[3].textContent.toLowerCase();

                    const coincideMes = mes === "" || celdaMes.includes(mes);
                    const coincideAño = año === "" || celdaAño.includes(año);
                    const coincideTipo = tipo === "" || celdaTipo == tipo;

                    if (coincideMes && coincideAño && coincideTipo) {
                        fila.style.display = "";
                        mensajeNoResultados.style.display = 'none';
                    } else {
                        fila.style.display = "none";
                        mensajeNoResultados.style.display = '';
                    }
                }

                verificarPagos();  // Verificar si hay resultados después de aplicar los filtros
            }

            function verificarPagos() {
                const tablaPagosBody = document.getElementById('tablaPagosBody');
                const filas = tablaPagosBody.getElementsByTagName('tr');
                const mensajeNoResultados = document.getElementById('mensajeNoResultados');

                let hayResultados = false;
                for (let i = 0; i < filas.length; i++) {
                    if (filas[i].style.display !== 'none') {
                        hayResultados = true;
                        break;
                    }
                }

                if (!hayResultados) {
                    mensajeNoResultados.style.display = '';
                } else {
                    mensajeNoResultados.style.display = 'none';
                }
            }

            // Agregar eventos para los tres filtros
            mesFiltro.addEventListener("change", filtrarTabla);
            añoFiltro.addEventListener("input", filtrarTabla);
            tipoFiltro.addEventListener("change", filtrarTabla);
        });
    </script>
    <script defer>
        //funcion para voltear los folios
        document.getElementById('contenedorFlecha2').addEventListener('click', function (event) {
            event.preventDefault();

            // flechas
            let abajo = document.getElementById('flechaDesc2');
            let arriba = document.getElementById('flechaAsc2');

            let orden; // Definir la variable "orden"

            // Verificar si está en descendente
            if (abajo.getAttribute('data-order') === 'desc') {
                // Cambio a orden ascendente
                abajo.innerHTML = '&uarr;';
                abajo.setAttribute('data-order', 'asc');
                orden = 'asc'; // Cambiar el valor de "orden"

                // Cambiar arriba a descendente
                arriba.innerHTML = '&darr;';
                arriba.setAttribute('data-order', 'desc');
            } else {
                // Cambio a orden descendente
                abajo.innerHTML = '&darr;';
                abajo.setAttribute('data-order', 'desc');
                orden = 'desc'; // Cambiar el valor de "orden"

                // Cambiar arriba a ascendente
                arriba.innerHTML = '&uarr;';
                arriba.setAttribute('data-order', 'asc');
            }

            let tbody = document.getElementById('tablaPagosPlazoBody');
            let filas = Array.from(tbody.getElementsByTagName('tr'));

            // Ordenar las filas en base a la primera columna (FOLIO)
            filas.sort(function (a, b) {
                let valorA = a.getElementsByTagName('td')[0].innerText;
                let valorB = b.getElementsByTagName('td')[0].innerText;

                if (orden === 'asc') {
                    return valorA.localeCompare(valorB, undefined, { numeric: true });
                } else {
                    return valorB.localeCompare(valorA, undefined, { numeric: true });
                }
            });

            // Limpiar el tbody y agregar las filas ordenadas
            tbody.innerHTML = '';
            filas.forEach(function (fila) {
                tbody.appendChild(fila);
            });
        });

    </script>
