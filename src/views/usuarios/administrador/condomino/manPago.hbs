                    </table>
                </div>

                {{!-- Tabla de la propiedad del usuario --}}
                <h1 class="font-semibold text-2xl flex justify-center m-5 text-gray-700">Propiedades del condómino</h1>
                <div class="overflow-x-auto max-h-60">
                    <table class="w-full">
                        <thead>
                            <tr>
                                <th class="px-2 py-2 bg-white border-b-2 border-gray-400 font-medium rounded-tl-lg">ID
                                    PROPIEDAD</th>
                                <th class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium ">DESCRIPCIÓN</th>
                                <th class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium rounded-tr-lg">TIPO
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each usuarioPro}}
                            <tr>
                                <td class="px-4 py-2 bg-white text-center border-b-2 border-gray-200 rounded-md">
                                    {{this.id_propiedad}}</td>
                                <td class="px-4 py-2 bg-white text-center border-b-2 border-gray-200">
