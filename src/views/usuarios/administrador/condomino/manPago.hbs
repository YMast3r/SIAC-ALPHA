    {{!-- Condición para ver si hay pagos --}}
    {{#if errorDatos}}
    <center>
        <h1 class="font-semibold text-4xl flex justify-center m-5">No hay pagos registrados</h1>
    </center>

    {{!-- Condición para ver si hay pagos --}}
    {{else}}

    <a href="/renderPago">
        <h1 class="font-semibold text-4xl hover:text-gray-400 flex justify-center">Pagos</h1>
    </a>
    <div class="text-center mb-5">

    </div>

    {{!-- CAMPOS DE BÚSQUEDA --}}

    <div class="flex flex-col items-center w-full">
        <div class="flex space-x-4 mt-4 items-center justify-center w-full max-w-4xl">
            <!-- Campo de búsqueda de año -->
            <div class="relative w-full max-w-md">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3">
                    <i class="fas fa-search text-gray-500"></i> <!-- Ícono de lupa -->
                </span>
                <input type="text" id="filtroAño" placeholder="Buscar por año..."
                    class="border border-gray-200 text-lg placeholder-gray-500 p-2 focus:bg-white hover:bg-gray-300 w-full rounded-lg pl-10 bg-white">
            </div>

            <!-- Selector de mes -->
            <div class="w-full max-w-xs">
                <div class="flex items-center space-x-2">
                    <span class="text-xl font-medium text-gray-700 whitespace-nowrap">Buscar por Mes</span>
                    <select id="mesFiltro"
                        class="border border-gray-200 text-lg placeholder-gray-500 p-2 focus:bg-white hover:bg-gray-300 rounded-lg bg-white w-full">
                        <option value="">Todos</option>
                        <option value="enero">Enero</option>
                        <option value="febrero">Febrero</option>
                        <option value="marzo">Marzo</option>
                        <option value="abril">Abril</option>
                        <option value="mayo">Mayo</option>
                        <option value="junio">Junio</option>
                        <option value="julio">Julio</option>
                        <option value="agosto">Agosto</option>
                        <option value="septiembre">Septiembre</option>
                        <option value="octubre">Octubre</option>
                        <option value="noviembre">Noviembre</option>
                        <option value="diciembre">Diciembre</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de pagos -->
    {{!-- --}}
    <div class="w-full">
        <div class="overflow-x-auto max-h-60 mb-10 w-4/5 mx-auto">
            <table class="w-full table-fixed" id="tablaPagos">
                <thead>
                    <tr>
                        <th
                            class="px-2 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center sticky top-0 rounded-l-lg">

                            <div id="contenedorFlecha" style="display: inline; cursor: pointer;">
                                FOLIO
                                <a href="?order=desc" id="flechaDesc" onclick="ordenarTabla()"
                                    data-order="desc">&darr;</a>
                                <a href="?order=asc" id="flechaAsc" onclick="ordenarTabla()" data-order="asc">&uarr;</a>
                            </div>
                        </th>
                        <th
                            class="px-2 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center sticky top-0">
                            AÑO</th>
                        <th
                            class="px-2 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center sticky top-0">
                            MES</th>
                        <th
                            class="px-2 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center sticky top-0">
                            TIPO PAGO</th>
                        <th
                            class="px-2 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center sticky top-0">
                            IMPORTE</th>
                        <th
                            class="px-2 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center sticky top-0">
                            RECARGO</th>
                        <th
                            class="px-2 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center sticky top-0">
                            TOTAL</th>
                        <th
                            class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center sticky top-0">
                            NO. RECIBO</th>
                        <th
                            class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center sticky top-0 rounded-r-lg">
                            PLAZO
                        </th>
                    </tr>
                </thead>
                <tbody id="tablaPagosBody">
                    {{#each datos}}
                    <tr class="w-full">
                        <td class="px-2 bg-white border-b-2 border-gray-200 text-lg text-center rounded-tl-lg">
                            {{this.folio}}</td>
                        <td class="px-1 bg-white border-b-2 border-gray-200 text-lg text-center">{{this.año}}</td>
                        <td class="py-2 bg-white border-b-2 border-gray-200 text-lg text-center">{{this.mes}}</td>
                        <td class="py-2 bg-white border-b-2 border-gray-200 text-lg text-center">{{this.tipo}}</td>
                        <td class="py-2 bg-white border-b-2 border-gray-200 text-lg text-center">${{this.importe}}</td>
                        <td class="py-2 bg-white border-b-2 border-gray-200 text-lg text-center">${{this.recargo}}</td>
                        <td class="py-2 bg-white border-b-2 border-gray-200 text-lg text-center">${{this.total}}</td>
                        <td class="py-2 bg-white border-b-2 border-gray-200 text-lg text-center">{{this.numero_recibo}}</td>
                        <td class="px-1 bg-white border-b-2 border-gray-200 text-lg text-center">0{{!-- plazo --}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
            <!-- Mensaje para cuando no se encuentran resultados -->
            <div id="mensajeNoResultados" class="text-center font-bold text-lg my-10" style="display: none;">
                No se encontró ningún pago
            </div>
        </div>
    </div>



    {{!-- Condición para ver si hay pagos --}}
    {{/if}}

    <div id="pagos" class="p-4 hidden">

        <div class="mx-auto my-8 p-4 bg-white w-full sm:w-5/6 md:w-4/6 lg:w-2/3 xl:w-1/3 border rounded-lg shadow-lg">
            <!-- Encabezado-->
            <!-- Título del formulario-->
            <h1 class="text-2x1 m-5 font-bold text-center">Regístra pago aquí</h1>

            <form action="/altaPago" method="POST" class="mt-4" enctype="multipart/form-data">
                <!-- Campos para los datos del pago-->

                <!-- Campo de tipo pago -->
                <label for="tipoPago"><i class="fas fa-money-bill-alt"></i> Tipo pago</label>
                <select id="tipoPago" name="tipoPago"
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10"
                    required>
                    {{#each tipoPago}}
                    <option value="{{this.id_tipo_pago}}">{{this.descripcion}}</option>
                    {{/each}}
                </select>

                <!-- Campo para ingresar el Recargo -->
                <label for="recargo" id="recargoLabel" class="block text-sm" style="display: none;">Recargo</label>
                <div class="relative" style="display: none;" id="recargoContainer">
                    <svg xmlns="http://www.w3.org/2000/svg"
                        class="absolute left-2 top-1/2 transform -translate-y-1/2 text-gray-500" width="24" height="24"
                        viewBox="0 0 24 24" stroke-width="1.5" stroke="#000000" fill="none" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M16.7 8a3 3 0 0 0 -2.7 -2h-4a3 3 0 0 0 0 6h4a3 3 0 0 1 0 6h-4a3 3 0 0 1 -2.7 -2" />
                        <path d="M12 3v3m0 12v3" />
                    </svg>
                    <input type="tel" id="recargo" name="recargo" placeholder="Recargo"
                        class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 pl-10 my-2 focus:bg-white hover:bg-gray-300"
                        value="{{data.recargo}}">
                </div>

                <label for="fecha"><i class="fas fa-calendar"></i> Fecha (Mes y Año)</label>
                <input type="month" id="fecha" name="fecha"
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-2"
                    required>

                {{#isEqual tipoUsuario 2}}
                <label for="reciboFolio"><i class="fas fa-user"></i> Recibo Folio</label>
                <input type="tel" id="reciboFolio" name="reciboFolio" placeholder="Recibo Folio"
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                {{/isEqual}}

                <label for="referencia"><i class="fas fa-user"></i> Referencia</label>
                <input type="text" id="referencia" name="referencia" placeholder="Referencia"
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">

                <!-- Campo para subir una imagen -->
                <label for="imagen"><i class="fas fa-image pr-2"></i>Sube un comprobante de pago</label>
                <input type="file" id="imagen" name="imagen" accept=".png, .jpg, .jpeg, .pdf"
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300"
                    {{#isEqual tipoUsuario 3}} required {{/isEqual}}>

                <!-- Botón para enviar el formulario -->
                <!--Se ajustó el margen superior e inferior del botón para una mejor distribución en dispositivos móviles. (mt-4 mb-2)-->
                <button type="submit"
                    class="rounded-md bg-gray-500 w-full text-white hover:bg-gray-600 focus:bg-gray-700 font-medium text-base px-6 py-3 block mt-4 mb-2 text-center">Enviar</button>

                <!--Sección para mostrar errores-->
                {{#if error}}
                <p class="text-red-500 font-bold text-lg my-3">*{{{error}}}</p>
                {{/if}}
            </form><!-- Cierre del formulario -->
            <script>
                // Mostrar alerta si hay un mensaje de error
                const errorMessage = '{{error}}'; // Aquí se pasa el mensaje de error desde el backend
                if (errorMessage) {
                    alert(errorMessage);
                    // Mostrar solo la sección seleccionada
                    document.getElementById('pagos').classList.remove('hidden');
                }
            </script>
        </div> <!-- Cierre del contenedor principal -->
    </div>

    <div id="pagos_plazos" class="p-4 hidden">

        {{#if errorDatosP}}
        <center>
            <h1 class="font-semibold text-4xl flex justify-center m-5">No hay pagos a plazos registrados</h1>
        </center>

        {{!-- Condición para ver si hay pagos --}}
        {{else}}

        <h1 class="font-semibold text-4xl flex justify-center m-5">Pagos plazo</h1>


        <!-- Tabla de pagos a plazos -->
        <!-- Tabla de pagos a plazos -->
        <div class="overflow-x-auto max-h-60 mb-10 w-4/5 mx-auto">
            <div class="overflow-x-auto w-full">
                <table class="min-w-full table-auto" id="tablaPagosPlazo">
                    <thead>
                        <tr>
                            <th
                                class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center w-auto rounded-tl-lg">
                                FOLIO
                            </th>
                            <th
                                class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center w-auto">
                                MES INICIO
                            </th>
                            <th
                                class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center w-auto">
                                AÑO INICIO
                            </th>
                            <th
                                class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center w-auto">
                                MES FINAL
                            </th>
                            <th
                                class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center w-auto">
                                AÑO FINAL
                            </th>
                            <th
                                class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center w-auto">
                                TIPO PAGO
                            </th>
                            <th
                                class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center w-auto">
                                IMPORTE
                            </th>
                            <th
                                class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center w-auto">
                                RECARGO
                            </th>
                            <th
                                class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center w-auto">
                                TOTAL
                            </th>
                            <th
                                class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center w-auto rounded-r-lg">
                                NÚMERO RECIBO
                            </th>
                    </thead>
                    <tbody id="tablaPagosPlazoBody">
                        {{#each datosPlazo}}
                        <tr>
                            <td
                                class="px-4 py-2 bg-white text-lg text-center border-b-2 border-gray-200 w-auto rounded-l-lg">
                                {{this.folio}}</td>
                            <td class="px-4 py-2 bg-white text-lg text-center border-b-2 border-gray-200 w-auto">
                                {{this.mes_inicio}}</td>
                            <td class="px-4 py-2 bg-white text-lg text-center border-b-2 border-gray-200 w-auto">
                                {{this.año_inicio}}</td>
                            <td class="px-4 py-2 bg-white text-lg text-center border-b-2 border-gray-200 w-auto">
                                {{this.mes_final}}</td>
                            <td class="px-4 py-2 bg-white text-lg text-center border-b-2 border-gray-200 w-auto">
                                {{this.año_final}}</td>
                            <td class="px-4 py-2 bg-white text-lg text-center border-b-2 border-gray-200 w-auto">
                                {{this.tipo_pago}}</td>
                            <td class="px-4 py-2 bg-white text-lg text-center border-b-2 border-gray-200 w-auto">
                                ${{this.importe}}</td>
                            <td class="px-4 py-2 bg-white text-lg text-center border-b-2 border-gray-200 w-auto">
                                ${{this.recargo}}</td>
                            <td class="px-4 py-2 bg-white text-lg text-center border-b-2 border-gray-200 w-auto">
                                ${{this.total}}</td>
                            <td
                                class="px-4 py-2 bg-white text-lg text-center border-b-2 border-gray-200 w-auto rounded-r-lg">
                                {{this.numero_recibo}}</td>

                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>

        {{/if}}
        {{!-- Formulario para los pagos en plazos --}}
        <!-- Encabezado-->
        <!-- Título del formulario-->
        <div class="mx-auto my-8 p-4 bg-white w-full sm:w-5/6 md:w-4/6 lg:w-2/3 xl:w-1/3 border rounded-lg shadow-lg">
            <h1 class="text-2x1 m-5 font-bold text-center">Regístra pago a plazo aquí</h1>

            <form action="/altaPagoPlazo" method="POST" class="mt-4" enctype="multipart/form-data">
                <!-- Campos para los datos del pago-->


                <!-- Campo de tipo pago -->
                <label for="tipoPagoPlazo"><i class="fas fa-money-bill-alt"></i> Tipo pago</label>
                <select id="tipoPagoPlazo" name="tipoPagoPlazo"
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10"
                    required>
                    {{#each tipoPago}}
                    <option value="{{this.id_tipo_pago}}">{{this.descripcion}}</option>
                    {{/each}}
                </select>

                <label for="recargoPlazo" id="recargoPlazoLabel" class="block text-sm"
                    style="display: none;">Recargo</label>
                <div class="relative" style="display: none;" id="recargoPlazoContainer">
                    <svg xmlns="http://www.w3.org/2000/svg"
                        class="absolute left-2 top-1/2 transform -translate-y-1/2 text-gray-500" width="24" height="24"
                        viewBox="0 0 24 24" stroke-width="1.5" stroke="#000000" fill="none" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M16.7 8a3 3 0 0 0 -2.7 -2h-4a3 3 0 0 0 0 6h4a3 3 0 0 1 0 6h-4a3 3 0 0 1 -2.7 -2" />
                        <path d="M12 3v3m0 12v3" />
                    </svg>
                    <input type="tel" id="recargoPlazo" name="recargoPlazo" placeholder="recargoPlazo"
                        class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 pl-10 my-2 focus:bg-white hover:bg-gray-300"
                        value="{{data.recargoPlazo}}">
                </div>

                <label for="fechaInicio"><i class="fas fa-calendar"></i> Fecha Inicial (Mes y Año)</label>
                <input type="month" id="fechaInicio" name="fechaInicio"
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300"
                    required>

                <!-- Campo para seleccionar el Mes y Año Final -->
                <label for="fechaFin"><i class="fas fa-calendar"></i> Fecha Final (Mes y Año)</label>
                <input type="month" id="fechaFin" name="fechaFin"
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300"
                    required>

                {{#isEqual tipoUsuario 2}}
                <label for="reciboFolioPlazo"><i class="fas fa-user"></i> Recibo Folio</label>
                <input type="tel" id="reciboFolioPlazo" name="reciboFolioPlazo" placeholder="Recibo Folio"
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                {{/isEqual}}

                <label for="referenciaPlazo"><i class="fas fa-user"></i> Referencia</label>
                <input type="text" id="referenciaPlazo" name="referenciaPlazo" placeholder="Referencia"
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">

                <!-- Campo para subir una imagen -->
                <label for="imagen"><i class="fas fa-image"></i> Sube un comprobante de pago</label>
                <input type="file" id="imagen" name="imagen" accept=".png, .jpg, .jpeg, .pdf"
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300"
                    {{#isEqual tipoUsuario 3}} required {{/isEqual}}>

                <!-- Botón para enviar el formulario -->
                <button type="submit"
                    class="rounded-md bg-gray-500 w-full text-white hover:bg-gray-600 focus:bg-gray-700 font-medium text-base px-6 py-3 block mt-4 mb-2 text-center">
                    Enviar
                </button>
                <!--Sección para mostrar errores-->
                {{#if errorP}}
                <p class="text-red-500 font-bold text-lg my-3">*{{{errorP}}}</p>
                {{/if}}
            </form><!-- Cierre del formulario -->
            <script>
                // Mostrar alerta si hay un mensaje de error
                const errorMessageP = '{{errorP}}'; // Aquí se pasa el mensaje de error desde el backend
                if (errorMessageP) {
                    alert(errorMessageP);
                    // Mostrar solo la sección seleccionada
                    document.getElementById('pagos_plazos').classList.remove('hidden');

                }
            </script>
        </div> <!-- Cierre del contenedor principal -->
    </div>

    {{!-- Condicon de propiedad --}}
    {{/if}}
    {{!-- Condicon en caso de que no haya una propiedad --}}
    {{else}}
    <h1 class="text-center font-bold text-lg my-10">No hay propiedades con ese condomino</h1>
    {{!-- Condicon para ver si hay propiedad --}}
    {{/if}}
    {{!-- Condicon de sesión --}}
    {{else}}
    <div style="display: flex; justify-content: center; align-items: center; height: 100vh;">
        <h1 style="font-size: 3em;">La sesión ha expirado. Por favor, inicie la sesión nuevamente.</h1>
    </div>
    {{!-- Condicon de sesión --}}
    {{/if}}
    <script defer src="imagen.js"></script>

    <script defer>
        // Abre una nueva ventana con la imagen en tamaño completo
        function mostrarImagen(src) {
            window.open(src, "_blank");
        }
        // Obtener los elementos de entrada por su ID
        const recargoInput = document.getElementById('recargo');
        // Obtener los elementos de entrada por su ID
        const recargoInputPlazo = document.getElementById('recargoPlazo');
        // Obtener los elementos de entrada por su ID
        const filtroAño = document.getElementById('filtroAño');
        // Obtener los elementos de entrada por su ID
        const reciboFolio = document.getElementById('reciboFolio');
        // Obtener los elementos de entrada por su ID
        const reciboFolioPlazo = document.getElementById('reciboFolioPlazo');

        function validarEntrada(event) {
            const regex = /^[a-zA-Z0-9\s]*$/;
            if (!regex.test(event.target.value)) {
                event.target.value = event.target.value.replace(/[^a-zA-Z0-9\s]/g, '');
            }
        }

        document.getElementById('referencia').addEventListener('input', validarEntrada);
        document.getElementById('referenciaPlazo').addEventListener('input', validarEntrada);

        // Función para validar que el input sea un número entero positivo
        function validarInput(input) {
            input.addEventListener('input', function () {
                // Remover caracteres no numéricos utilizando una expresión regular
                let valor = input.value.replace(/\D/g, '');
                // Asignar el valor limpio al campo de entrada
                input.value = valor;
            });
        }

        // Función para validar que el input sea un número con hasta dos decimales
        function validarInputF(input) {
            input.value = '0.00';
            input.addEventListener('input', function () {

                let value = input.value.replace(/\D/g, ''); // Eliminar cualquier carácter que no sea un dígito
                let floatValue = (parseFloat(value) / 100).toFixed(2); // Convertir a decimal (dos decimales)

                // Si no hay valor, establece el valor inicial
                if (value === '') {
                    input.value = '0.00';
                    return;
                }

                // Aplicar formato de número con comas
                let formattedValue = floatValue.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");

                input.value = formattedValue;
            });

        }

        // Llamar a la función validarInput para cada input
        validarInputF(recargoInput);
        validarInputF(recargoInputPlazo);
        validarInput(filtroAño);
        validarInput(reciboFolio);
        validarInput(reciboFolioPlazo);

        document.getElementById('tipoPago').addEventListener('change', function () {
            var recargoLabel = document.getElementById('recargoLabel');
            var recargoInput = document.getElementById('recargoContainer');
            if (this.value == '2') {
                recargoLabel.style.display = 'block';
                recargoInput.style.display = 'block';
            } else {
                recargoLabel.style.display = 'none';
                recargoInput.style.display = 'none';
            }
        });

        document.getElementById('tipoPagoPlazo').addEventListener('change', function () {
            var recargoLabelPlazo = document.getElementById('recargoPlazoLabel');
            var recargoPlazo = document.getElementById('recargoPlazoContainer');
            if (this.value == '2') {
                recargoLabelPlazo.style.display = 'block';
                recargoPlazo.style.display = 'block';
            } else {
                recargoLabelPlazo.style.display = 'none';
                recargoPlazo.style.display = 'none';
            }
        });

        // Función para mostrar una sección y ocultar las demás
        function mostrarSeccion(seccion) {
            // Ocultar todas las secciones
            document.getElementById('pagos').classList.add('hidden');
            document.getElementById('pagos_plazos').classList.add('hidden');
            document.getElementById('info').classList.add('hidden');

            // Mostrar solo la sección seleccionada
            document.getElementById(seccion).classList.remove('hidden');
        }
    </script>
    <script defer>
        document.addEventListener("DOMContentLoaded", function () {
            const mesFiltro = document.getElementById("mesFiltro");
            const añoFiltro = document.getElementById("filtroAño");
            const tablaPagos = document.getElementById("tablaPagos");
            const filas = tablaPagos.getElementsByTagName("tr");

            function filtrarTabla() {
                const mes = mesFiltro.value.toLowerCase();
                const año = añoFiltro.value.toLowerCase();

                for (let i = 1; i < filas.length; i++) {
                    const fila = filas[i];
                    const celdaMes = fila.cells[2].textContent.toLowerCase();
                    const celdaAño = fila.cells[1].textContent.toLowerCase();

                    // Verificar si la fila coincide con el mes y el año filtrados
                    const coincideMes = mes === "" || celdaMes.includes(mes);
                    const coincideAño = año === "" || celdaAño.includes(año);

                    if (coincideMes && coincideAño) {
                        fila.style.display = "";
                    } else {
                        fila.style.display = "none";
                    }
                }
            }

            // Agregar eventos de escucha para cuando cambian los valores de los filtros
            mesFiltro.addEventListener("change", filtrarTabla);
            añoFiltro.addEventListener("input", filtrarTabla);

            function verificarPagos() {
                const tablaPagosBody = document.getElementById('tablaPagosBody');
                const filas = tablaPagosBody.getElementsByTagName('tr');
                const mensajeNoResultados = document.getElementById('mensajeNoResultados');

                let hayResultados = false;
                for (let i = 0; i < filas.length; i++) {
                    if (filas[i].style.display !== 'none') {
                        hayResultados = true;
                        break;
                    }
                }

                if (!hayResultados) {
                    mensajeNoResultados.style.display = 'block';
                } else {
                    mensajeNoResultados.style.display = 'none';
                }
            }

            // Llamar a la función después de aplicar filtros
            document.getElementById('filtroAño').addEventListener('input', verificarPagos);
            document.getElementById('mesFiltro').addEventListener('change', verificarPagos);
        });

        document.getElementById('contenedorFlecha').addEventListener('click', function (event) {
            event.preventDefault();

            // flechas
            let abajo = document.getElementById('flechaDesc');
            let arriba = document.getElementById('flechaAsc');

            let orden; // Definir la variable "orden"

            // Verificar si está en descendente
            if (abajo.getAttribute('data-order') === 'desc') {
                // Cambio a orden ascendente
                abajo.innerHTML = '&uarr;';
                abajo.setAttribute('data-order', 'asc');
                orden = 'asc'; // Cambiar el valor de "orden"

                // Cambiar arriba a descendente
                arriba.innerHTML = '&darr;';
                arriba.setAttribute('data-order', 'desc');
            } else {
                // Cambio a orden descendente
                abajo.innerHTML = '&darr;';
                abajo.setAttribute('data-order', 'desc');
                orden = 'desc'; // Cambiar el valor de "orden"

                // Cambiar arriba a ascendente
                arriba.innerHTML = '&uarr;';
                arriba.setAttribute('data-order', 'asc');
            }

            let tbody = document.getElementById('tablaPagosBody');
            let filas = Array.from(tbody.getElementsByTagName('tr'));

            // Ordenar las filas en base a la primera columna (FOLIO)
            filas.sort(function (a, b) {
                let valorA = a.getElementsByTagName('td')[0].innerText;
                let valorB = b.getElementsByTagName('td')[0].innerText;

                if (orden === 'asc') {
                    return valorA.localeCompare(valorB, undefined, { numeric: true });
                } else {
                    return valorB.localeCompare(valorA, undefined, { numeric: true });
                }
            });

            // Limpiar el tbody y agregar las filas ordenadas
            tbody.innerHTML = '';
            filas.forEach(function (fila) {
                tbody.appendChild(fila);
            });
        });

    </script>
</body>

</html>