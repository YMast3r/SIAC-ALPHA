<!DOCTYPE html>
<html lang="es">

<head>
    <script src="https://cdn.tailwindcss.com"></script><!-- sirve para usar tailwind -->
</head>

<body class="bg-indigo-300 flex items-center justify-center min-h-screen">

    {{#if name}}

    {{!-- condición para ver si tiene propiedades --}}
    {{#if propia}}
    {{!-- condición para que muestre las propiedades --}}
    {{#if propiedades}}

    {{!-- Tabla de las propiedades del condomino--}}
    <div class="text-center">
        <h1 class="font-semibold text-4xl flex justify-center m-5 pt-5 ">Propiedades del condómino</h1>
        <div class="overflow-x-auto max-h-60  rounded-lg  pt-5 ">
            <table class="w-full max-w-5xl mx-auto rounded-lg overflow-hidden">
                <thead>
                    <tr>
                        <th class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium rounded-tl-lg">ID PROPIEDAD
                        </th>
                        <th class="px-6 py-4 bg-white border-b-2 border-gray-400 font-medium">DESCRIPCIÓN</th>
                        <th class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium">TIPO</th>
                        <th class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium rounded-tr-lg"> </th>
                    </tr>
                </thead>
                <tbody>
                    {{#each propiedades}}
                    <tr>
                        <td class="px-4 py-2 bg-white text-center border-b-2 border-gray-200">{{this.id_propiedad}}</td>
                        <td class="px-6 py-2 bg-white border-b-2 border-gray-200">{{this.descripcion}}</td>
                        <td class="px-4 py-2 bg-white border-b-2 border-gray-200">{{this.tipo_propiedad}}</td>
                        <td class="px-4 py-2 bg-white border-b-2 border-gray-200 text-center">
                            <a href="/manPago-{{this.id_propiedad}}"
                                class="px-4 py-2 text-white bg-gray-600 border-gray-400 font-medium rounded-md hover:bg-gray-700">Seleccionar</a>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>

        </div>
    </div>

    {{else}}

<div>
            <nav class="flex justify-end {{!-- space-x-4 --}} bg-gray-200 pr-2">
                
                <button id="formaClipPath3" class=" w-20 {{!-- border-l-2 border-solid border-white --}} overflow-hidden bg-gray-400 hover:bg-gray-700 text-white font-bold py-2 px-2 whitespace-nowrap transition-all duration-300 ease-in-out hover:w-72 rounded-b-lg  gray-500 -mr-5  clip-path-Forma-Triangular"
                    onclick="mostrarSeccion('info')">Información del condómino
                </button>

                <button id="formaClipPath2" class=" w-20 {{!-- border-r-2 border-l-2 border-solid border-white-100 --}} overflow-hidden bg-gray-500 hover:bg-gray-700 text-white font-bold py-2 px-2 whitespace-nowrap transition-all duration-300 ease-in-out hover:w-28 rounded-b-lg  hover:gray-500 -mr-4    "
                    onclick="mostrarSeccion('pagos')">Pagos 
                </button>

                <button id="formaClipPath" class=" w-16 {{!-- border-l-2 border-solid border-white-100 --}} overflow-hidden bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-2 whitespace-nowrap transition-all duration-300 ease-in-out hover:w-36 rounded-b-lg  hover: gray-500 -mr-4 clip-path-Pestañas " onclick="mostrarSeccion('pagos_plazos')"  >  Plazos de pagos 
                </button>

            </nav>
        </div>
        <script>
            // Selecciona los elementos y sus configuraciones
            const elementos = [
                { id: 'formaClipPath', top: '-1px', textoInicial: 'Plazos', textoHover: 'Pago a plazos', widthInicial: '5rem', widthHover: '9rem' },
                { id: 'formaClipPath2', top: '-2px', widthInicial: '6rem' },
                { id: 'formaClipPath3', top: '-1px', textoInicial: 'Info.', textoHover: 'Información del condómino', widthInicial: '5.5rem', widthHover: '18rem' }
            ];

            // Función para aplicar el clip-path y estilos
            elementos.forEach(elemento => {
                const el = document.getElementById(elemento.id);
                el.style.clipPath = 'polygon(5% 0, 95% 0, 100% 50%, 95% 100%, 5% 100%, 0 50%)';
                el.style.position = 'relative';
                el.style.top = elemento.top;

                if (elemento.textoInicial) {
                    el.textContent = elemento.textoInicial;
                    el.style.width = elemento.widthInicial;

                    el.addEventListener('mouseover', () => {
                        el.style.width = elemento.widthHover;
                        el.textContent = elemento.textoHover;
                    });

                    el.addEventListener('mouseout', () => {
                        el.style.width = elemento.widthInicial;
                        el.textContent = elemento.textoInicial;
                    });
                }
            });
        </script>

    <div class="flex justify-around bg-gray-200 p-4">
        <a href="/renderRecuperarPropiedadPago">
            <h1 class="font-semibold text-4xl hover:text-gray-400 flex justify-center m-2">Propiedad</h1>
        </a>
    </div>

    <div id="info" class="p-4 hidden">

        <div class="flex flex-col items-center">
            <div class="w-full max-w-4xl">
                {{!-- Tabla del condómino --}}
                <h1 class="font-semibold text-2xl flex justify-center m-5 text-gray-700">Condómino</h1>
                <div class="overflow-x-auto max-h-60 mb-8 ">
                    <table class="w-full">
                        <thead>
                            <tr>
                                <th class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium rounded-tl-lg">ID
                                </th>
                                <th class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium">NOMBRE</th>
                                <th class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium">CORREO</th>
                                <th class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium">TELÉFONO</th>
