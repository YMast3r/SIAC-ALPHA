<!DOCTYPE html>
<html lang="es">

<head>
    <script src="https://cdn.tailwindcss.com"></script><!-- sirve para usar tailwind -->
</head>

<body class="bg-indigo-300 flex items-center justify-center min-h-screen">

    {{#if name}}

    {{!-- condición para ver si tiene propiedades --}}
    {{#if propia}}
    {{!-- condición para que muestre las propiedades --}}
    {{#if propiedades}}

    {{!-- Tabla de las propiedades del condomino--}}
    <div class="text-center">
        <h1 class="font-semibold text-4xl flex justify-center m-5 pt-5">Propiedades del condómino</h1>


        <div class="w-full">
            <div class="overflow-x-auto max-h-60 mb-10 w-4/5 mx-auto  max-h-80">
                <table class="w-full {{!-- table-fixed --}}">
                    <thead class="sticky top-0">
                        <tr>
                            <th class="px-4 py-4 bg-white border-b-2 border-gray-400 text-xl font-medium rounded-tl-lg">ID PROPIEDAD</th>
                            <th class="px-6 py-4 bg-white border-b-2 border-gray-400 text-xl font-medium">DIRECCIÓN</th>
                            <th class="px-4 py-4 bg-white border-b-2 border-gray-400 text-xl font-medium">TIPO</th>
                            <th class="px-4 py-4 bg-white border-b-2 border-gray-400 text-xl font-medium">PRECIO</th>
                            <th class="px-4 py-4 bg-white border-b-2 border-gray-400 text-xl font-medium">FECHA ANEXO</th>
                            <th class="px-4 py-4 bg-white border-b-2 border-gray-400 text-xl font-medium rounded-tr-lg"> </th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each propiedades}}
                        <tr>
                            <td class="px-4 py-2 text-lg bg-white text-center border-b-2 border-gray-200">{{this.id_propiedad}}</td>
                            <td class="px-6 py-2 text-lg bg-white border-b-2 border-gray-200">{{this.descripcion}}</td>
                            <td class="px-4 py-2 text-lg bg-white border-b-2 border-gray-200">{{this.tipo_propiedad}}</td>
                            <td class="px-4 py-2 text-lg bg-white border-b-2 border-gray-200">${{this.pago}}</td>
                            <td class="px-4 py-2 text-lg bg-white border-b-2 border-gray-200">{{this.fecha_anexo}}</td>
                            <td class="px-4 py-2 text-lg bg-white border-b-2 border-gray-200 text-center">
                                <a id="{{this.id_propiedad}}" href="/manPago-{{this.id_propiedad}}"
                                    class="px-4 py-2 text-white bg-gray-600 border-gray-400 font-medium rounded-md hover:bg-gray-700">Seleccionar</a>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {{else}}

    {{!-- ---PESTAÑAS--- --}}

    <div class="sticky top-0 relative z-10">
        <nav class="flex justify-end bg-gray-200 pr-2 sticky top-0 ">

                <button id="formaClipPath3" class=" w-20 overflow-hidden bg-gray-400 hover:bg-gray-700 text-white font-bold py-2 px-2 whitespace-nowrap transition-all duration-300 ease-in-out hover:w-72 rounded-b-lg  gray-500 -mr-5  clip-path-Forma-Triangular"
                onclick="mostrarSeccion('info')">Información del condómino
            </button>

                <button id="formaClipPath2" class=" w-24 overflow-hidden bg-gray-500 hover:bg-gray-700 text-white font-bold py-2 px-2 whitespace-nowrap transition-all duration-300 ease-in-out hover:w-32 rounded-b-lg  hover:gray-500 -mr-4  "
                onclick="mostrarSeccion('pagos')">Pagos
            </button>

                <button id="formaClipPath" class=" w-16 overflow-hidden bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-2 whitespace-nowrap transition-all duration-300 ease-in-out hover:w-36 rounded-b-lg  hover: gray-500 -mr-4 clip-path-Pestañas " onclick="mostrarSeccion('pagos_plazos')"  >  Alta varios pagos 
            </button>

        </nav>
    </div>
    <script>
        // Selecciona los elementos y sus configuraciones
        const elementos = [
            { id: 'formaClipPath', textoInicial: 'Varios', textoHover: 'Alta de varios pagos', widthInicial: '7rem', widthHover: '11rem' },
            { id: 'formaClipPath2', widthInicial: '6rem' },
            { id: 'formaClipPath3', textoInicial: 'Info.', textoHover: 'Información del condómino', widthInicial: '5.5rem', widthHover: '18rem' }
        ];

        // Función para aplicar el clip-path y estilos
        elementos.forEach(elemento => {
            const el = document.getElementById(elemento.id);
            el.style.clipPath = 'polygon(5% 0, 95% 0, 100% 50%, 95% 100%, 5% 100%, 0 50%)';
            el.style.position = 'relative';
            el.style.top = elemento.top;

            if (elemento.textoInicial) {
                el.textContent = elemento.textoInicial;
                el.style.width = elemento.widthInicial;

                el.addEventListener('mouseover', () => {
                    el.style.width = elemento.widthHover;
                    el.textContent = elemento.textoHover;
                });

                el.addEventListener('mouseout', () => {
                    el.style.width = elemento.widthInicial;
                    el.textContent = elemento.textoInicial;
                });
            }
        });
    </script>

    <div class="flex justify-around bg-gray-200 p-4">
        <a id="renderRecuperarPropiedadPago" href="/renderRecuperarPropiedadPago">
            <h1 class="font-semibold text-4xl hover:text-gray-400 flex justify-center m-2">Propiedades del condómino</h1>
        </a>
    </div>

    {{!-- Condición para ver si hay pagos --}}
    {{#if errorDatos}}
    <center>
        <h1 class="font-semibold text-4xl flex justify-center m-5">No hay pagos registrados</h1>
        {{#each usuarioPro}}
        <P>Por favor, realice el pago correspondiente a la fecha del anexo de la propiedad que corresponde al mes de {{this.mes}} del año 20{{this.año}}</P>
        {{/each}}
    </center>

    {{!-- Condición para ver si hay pagos --}}
    {{else}}

    <a id="renderPago" href="/renderPago">
        <h1 class="font-semibold text-4xl hover:text-gray-400 flex justify-center">Pagos</h1>
    </a>
    <div class="text-center mb-5">

    </div>

    {{!-- CAMPOS DE BÚSQUEDA --}}
    <div class="flex flex-col items-center w-full">
        <div class="flex space-x-4 mb-1 items-center justify-center w-full max-w-4xl">
            <!-- Selector de mes -->
            <div class="w-full max-w-xs">
            <div class="flex items-center space-x-2">
                <span class="text-xl font-medium text-gray-700 whitespace-nowrap">Buscar por Mes</span>
                <select id="mesFiltro"
                        class="border border-gray-200 text-lg placeholder-gray-500 p-2 focus:bg-white hover:bg-gray-300 rounded-lg bg-white w-full">
                <option value="">Todos</option>
                <option value="enero">Enero</option>
                <option value="febrero">Febrero</option>
                <option value="marzo">Marzo</option>
                <option value="abril">Abril</option>
                <option value="mayo">Mayo</option>
                <option value="junio">Junio</option>
                <option value="julio">Julio</option>
                <option value="agosto">Agosto</option>
                <option value="septiembre">Septiembre</option>
                <option value="octubre">Octubre</option>
                <option value="noviembre">Noviembre</option>
                <option value="diciembre">Diciembre</option>
                </select>
            </div>
            </div>
            <!-- Campo de búsqueda de año (centrado) -->
            <div class="relative w-full max-w-md">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3">
                <i class="fas fa-search text-gray-500"></i> <!-- Ícono de lupa -->
            </span>
            <input type="text" id="filtroAño" placeholder="Buscar por año..."
                    class="border border-gray-200 text-lg placeholder-gray-500 p-2 focus:bg-white hover:bg-gray-300 w-full rounded-lg pl-10 bg-white">
            </div>
            <!-- Selector de tipo -->
            <div class="w-full max-w-xs">
            <div class="flex items-center space-x-2">
                <span class="text-xl font-medium text-gray-700 whitespace-nowrap">Buscar por Tipo</span>
                <select id="tipoFiltro"
                        class="border border-gray-200 text-lg placeholder-gray-500 p-2 focus:bg-white hover:bg-gray-300 rounded-lg bg-white w-full">
                <option value="">Todos</option>
                {{#each tipoPagoFiltro}}
                <option value="{{this.descripcion}}">{{this.descripcion}}</option>
                {{/each}}
                </select>
            </div>
            </div>
        </div>
    </div>


    <!-- Tabla de pagos -->
    <div class="w-full">
        <div class="overflow-x-auto max-h-72 mb-10 w-11/12 mx-auto">
            <table class="w-full table-fixed" id="tablaPagos">
                <thead>
                    <tr>
                    <th id="contenedorFlecha" style="cursor: pointer;" class="px-2 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center sticky top-0 rounded-l-lg">
                            FOLIO
                            <span class="inline-flex items-center space-x-1">
                                <a href="#" id="flechaDesc" data-order="desc">&darr;</a>
                                <a href="#" id="flechaAsc" data-order="asc">&uarr;</a>
                            </span>
                        </th>
                    <th class="px-2 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center sticky top-0">
                            AÑO
                        </th>
                    <th class="px-2 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center sticky top-0">
                            MES
                        </th>
                    <th class="px-2 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center sticky top-0">
                            TIPO PAGO
                        </th>
                    <th class="px-2 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center sticky top-0">
                            IMPORTE
                        </th>
                    <th class="px-2 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center sticky top-0">
                            RECARGO
                        </th>
                    <th class="px-2 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center sticky top-0">
                            TOTAL
                        </th>
                    <th class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center sticky top-0">
                            NO. RECIBO
                        </th>
                    <th class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center sticky top-0">
                            ID DE VARIOS PAGOS
                        </th>
                    <th class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center sticky top-0">
                            C/A
                        </th>
                    {{#isEqual tipoUsuario 2}}
                    <th class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center sticky top-0 rounded-r-lg"> </th>
                    {{/isEqual}}

                    </tr>
                </thead>
                <tbody id="tablaPagosBody">
                    {{#isEqual tipoUsuario 3}}
                    {{#each datos}}
                    <tr class="w-full">
                    <td class="px-2 bg-white border-b-2 border-gray-200 text-lg text-center rounded-tl-lg">{{this.folio}}</td>
                        <td class="px-1 bg-white border-b-2 border-gray-200 text-lg text-center">{{this.año}}</td>
                        <td class="py-2 bg-white border-b-2 border-gray-200 text-lg text-center">{{this.mes}}</td>
                        <td class="py-2 bg-white border-b-2 border-gray-200 text-lg text-center">{{this.tipo}}</td>
                        <td class="py-2 bg-white border-b-2 border-gray-200 text-lg text-center">${{this.importe}}</td>
                        <td class="py-2 bg-white border-b-2 border-gray-200 text-lg text-center">${{this.recargo}}</td>
                        <td class="py-2 bg-white border-b-2 border-gray-200 text-lg text-center">${{this.total}}</td>
                        <td class="py-2 bg-white border-b-2 border-gray-200 text-lg text-center">{{this.numero_recibo}}</td>
                        <td class="px-1 bg-white border-b-2 border-gray-200 text-lg text-center">{{this.plazo}}</td>
                        <td class="px-1 bg-white border-b-2 border-gray-200 text-lg text-center">{{this.C_A}}</td>
                    </tr>
                    {{/each}}
                    {{else}}
                    {{#each datos}}
                    <tr class="w-full">
                    <td class="px-2 bg-white border-b-2 border-gray-200 text-lg text-center rounded-tl-lg">{{this.folio}}</td>
                        <td class="px-1 bg-white border-b-2 border-gray-200 text-lg text-center">{{this.año}}</td>
                        <td class="py-2 bg-white border-b-2 border-gray-200 text-lg text-center">{{this.mes}}</td>
                        <td class="py-2 bg-white border-b-2 border-gray-200 text-lg text-center">{{this.tipo}}</td>
                        <td class="py-2 bg-white border-b-2 border-gray-200 text-lg text-center">${{this.importe}}</td>
                        <td class="py-2 bg-white border-b-2 border-gray-200 text-lg text-center">${{this.recargo}}</td>
                        <td class="py-2 bg-white border-b-2 border-gray-200 text-lg text-center">${{this.total}}</td>
                        <td class="py-2 bg-white border-b-2 border-gray-200 text-lg text-center">{{this.numero_recibo}}</td>
                        <td class="px-1 bg-white border-b-2 border-gray-200 text-lg text-center">{{this.plazo}}</td>
                        <td class="px-1 bg-white border-b-2 border-gray-200 text-lg text-center">{{this.C_A}}</td>
                        <td class="px-4 py-2 bg-white text-center border-b-2 border-gray-200">
                            <a id="{{this.folio}}" href="/manActivoCancelado-{{this.folio}}"
                                class="px-4 py-2 text-white bg-gray-600 border-gray-400 font-medium rounded-md">Cancelar</a>
                        </td>
                    </tr>
                    {{/each}}
                    {{/isEqual}}
                </tbody>
            <tbody id="mensajeNoResultados" style="display: none;">
                    <tr>
                        <td colspan="11" class="px-4 py-4 bg-white text-center font-normal rounded text-lg">     
                            No se encontró ningún pago
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>



    {{!-- Condición para ver si hay pagos --}}
    {{/if}}

    <div id="pagos" class="p-4 hidden">

        <div class="mx-auto my-8 p-4 bg-white w-full sm:w-5/6 md:w-4/6 lg:w-2/3 xl:w-1/3 border rounded-lg shadow-lg">
            <!-- Encabezado-->
            <!-- Título del formulario-->
            <h1 class="text-2x1 m-5 font-bold text-center  text-xl">Registra pago aquí</h1>

            <form action="/altaPago" method="POST" class="mt-4" enctype="multipart/form-data">
                <!-- Campos para los datos del pago-->

                <div id="precioPagoContainer" class="flex space-x-4 mt-4">
                    {{!-- tipo de pago --}}
                    <div class="w-1/2">
                        <label for="tipoPago"><i class="fas fa-money-bill-alt"></i> Tipo pago</label>
                        <select id="tipoPago" name="tipoPago"
                            class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10"
                            required>
                            <option selected value="">Selecciona el tipo de pago</option>
                            {{#each tipoPago}}
                            <option value="{{this.id_tipo_pago}}" 
                                data-precioPago="{{this.importe}}"
                                data-recargoPago="{{this.recargo}}"
                                data-meses="{{this.meses_por_pagar}}"
                                data-fechaR="{{this.fecha}}"
                                data-mes="{{this.mes}}"
                                data-year="{{this.year}}">
                                {{this.descripcion}}
                            </option>
                            {{/each}}
                        </select>
                    </div>
                    <!-- Campos ocultos para almacenar los valores data-* -->
                    <input type="hidden" name="importe" id="importe">
                    <input type="hidden" name="recargoPago" id="recargoPago">
                    <input type="hidden" name="meses" id="meses">
                    <input type="hidden" name="fechaR" id="fechaR">
                    <input type="hidden" name="mes" id="mes">
                    <input type="hidden" name="year" id="year">
                    <input type="hidden" name="cuotaPago" id="cuotaPago">

                    {{!-- Monto --}}
                    <div class="w-1/2">
                        <h3 id="mensajePago"> <i class="fas fa-money-bill-alt"></i> Monto </h3>
                        <input type="text" id="precioPago" name="precio" readonly
                            class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white" />
                    </div>
                </div>

                <!-- Campo para ingresar el Recargo -->
                <div style="display: none;" id="recargoContainer" class="w-full overflow-hidden">
                    <label for="recargo" id="recargoLabel" class="block text-lg"><i class="fa-solid fa-calendar-days"></i>
                    Recargo y meses por pagar</label>
                    <textarea id="recargo" name="recargo" placeholder="Recargo" readonly
                        class="border border-gray-200 w-full text-lg p-2 pl-1 my-2 focus:bg-white hover:bg-gray-300 resize-y h-auto min-h-[2.5rem]">
                    </textarea>
                </div>

                <label for="fecha"><i class="fas fa-calendar"></i> Fecha</label>
                <input type="month" id="fecha" name="fecha" placeholder="YYYY-MM" value="{{data.fecha}}"
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-2"
                    required>

                {{#isEqual tipoUsuario 2}}
                <label for="reciboFolio"><i class="fas fa-user"></i> Recibo Folio</label>
                <input type="tel" id="reciboFolio" name="reciboFolio" placeholder="Recibo Folio" value="{{data.reciboFolio}}"
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                {{else}}
                <label for="referencia"><i class="fas fa-user"></i> Referencia</label>
                <input type="text" id="referencia" name="referencia" placeholder="Referencia" value="{{data.referencia}}"
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                {{/isEqual}}

                <!-- Campo para subir una imagen -->
                <label for="imagen"><i class="fas fa-image pr-2"></i>Sube un comprobante de pago</label>
                <input type="file" id="imagen" name="imagen" accept=".png, .jpg, .jpeg, .pdf"
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300"
                    {{#isEqual tipoUsuario 3}} required {{/isEqual}}>

                <!-- Botón para enviar el formulario -->
                <!--Se ajustó el margen superior e inferior del botón para una mejor distribución en dispositivos móviles. (mt-4 mb-2)-->
                <button id="enviarPago" type="submit"
                    class="rounded-md bg-gray-500 w-full text-white hover:bg-gray-600 focus:bg-gray-700 font-medium text-base px-6 py-3 block mt-4 mb-2 text-center">Enviar</button>

                <!--Sección para mostrar errores-->
                {{#if error}}
                <p class="text-red-500 font-bold text-lg my-3">*{{{error}}}</p>
                {{/if}}
            </form><!-- Cierre del formulario -->
        </div> <!-- Cierre del contenedor principal -->
    </div>

    <div id="pagos_plazos" class="p-4 hidden">

        {{#if errorDatosP}}
        <center>
            <h1 class="font-semibold text-4xl flex justify-center m-5">No hay pagos a plazos registrados</h1>
        </center>

        {{!-- Condición para ver si hay pagos --}}
        {{else}}

        <h1 class="font-semibold text-4xl flex justify-center m-5">Pagos plazo</h1>


        <!-- Tabla de pagos a plazos -->
        <div class="w-full">
            <div class="overflow-x-auto max-h-60 mb-10 w-4/5 mx-auto">
                <table class="w-full" id="tablaPagosPlazo">
                    <thead class="sticky top-0">
                        <tr>
                            <th id="contenedorFlecha2" style="cursor: pointer;"
                                class="px-2 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center sticky top-0 rounded-l-lg">
                                FOLIO
                                <span class="inline-flex items-center space-x-1">
                                    <a href="#" id="flechaDesc2" data-order="desc">&darr;</a>
                                    <a href="#" id="flechaAsc2" data-order="asc">&uarr;</a>
                                </span>
                            </th>
                            <th
                                class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center w-auto">
                                FECHA INICIO
                            </th>
                            <th
                                class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center w-auto">
                                FECHA FINAL
                            </th>
                            <th
                                class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center w-auto">
                                TIPO PAGO
                            </th>
                            <th
                                class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center w-auto">
                                IMPORTE
                            </th>
                            <th
                                class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center w-auto">
                                RECARGO
                            </th>
                            <th
                                class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center w-auto">
                                TOTAL
                            </th>
                            <th
                                class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-xl text-center w-auto rounded-r-lg">
                                NÚMERO RECIBO
                            </th>
                    </thead>
                    <tbody id="tablaPagosPlazoBody">
                        {{#each datosPlazo}}
                        <tr>
                            <td
                                class="px-4 py-2 bg-white text-lg text-center border-b-2 border-gray-200 w-auto rounded-l-lg">
                                {{this.folio}}</td>
                            <td class="px-4 py-2 bg-white text-lg text-center border-b-2 border-gray-200 w-auto">
                                {{this.mes_inicio}}-{{this.año_inicio}}</td>
                            <td class="px-4 py-2 bg-white text-lg text-center border-b-2 border-gray-200 w-auto">
                                {{this.mes_final}}-{{this.año_final}}</td>
                            <td class="px-4 py-2 bg-white text-lg text-center border-b-2 border-gray-200 w-auto">
                                {{this.tipo_pago}}</td>
                            <td class="px-4 py-2 bg-white text-lg text-center border-b-2 border-gray-200 w-auto">
                                ${{this.importe}}</td>
                            <td class="px-4 py-2 bg-white text-lg text-center border-b-2 border-gray-200 w-auto">
                                ${{this.recargo}}</td>
                            <td class="px-4 py-2 bg-white text-lg text-center border-b-2 border-gray-200 w-auto">
                                ${{this.total}}</td>
                            <td
                                class="px-4 py-2 bg-white text-lg text-center border-b-2 border-gray-200 w-auto rounded-r-lg">
                                {{this.numero_recibo}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>

        {{/if}}
        {{!-- Formulario para los pagos en plazos --}}
        <h1 class="text-2x1 m-5 font-bold text-center  text-xl">Registra pago a plazo aquí</h1>
        <div class="mx-auto my-8 p-4 bg-white w-full sm:w-5/6 md:w-4/6 lg:w-2/3 xl:w-1/3 border rounded-lg shadow-lg">
        <!-- Título del formulario-->
            

            <form action="/altaPagoPlazo" method="POST" class="mt-4" enctype="multipart/form-data">
                <!-- Campos para los datos del pago-->

                <!-- Contenedor con flex para alinear los campos horizontalmente -->
                <div id="precioContainer" class="flex space-x-4 mt-4">
                    <!-- Campo de tipo pago -->
                    <div class="w-1/2">
