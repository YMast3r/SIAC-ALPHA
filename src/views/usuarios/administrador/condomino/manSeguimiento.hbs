{{#if name}}
<!DOCTYPE html>
<html lang="es">

<head>
    <script src="https://cdn.tailwindcss.com"></script><!-- sirve para usar tailwind -->
    {{!-- LIBRERIAS --}}
    <link href="/select2/css/select2.min.css" rel="stylesheet" />
    <script src="/jquery/jquery.min.js"></script>
    <script src="/select2/js/select2.min.js"></script>
</head>

<body class="bg-indigo-300">

    <!-- Sección de Datos -->
    <div class="flex flex-col items-center mt-4">
        <!-- Enlace al seguimiento -->
        <a href="/renderSeguimiento" class="mb-4">
            <h1 class="font-semibold text-4xl flex justify-center m-5">Seguimiento</h1>
        </a>

        <!-- Subtítulo del Condomino -->
        <h2 class="font-semibold text-2xl flex justify-center m-1 text-gray-700">Condómino</h2>

        <!-- Tabla de usuarios -->
        <div class="overflow-x-auto max-h-60 w-7/12 rounded-lg mt-4">
            <table class="w-full rounded-lg overflow-hidden">
                <thead>
                    <tr>
                        <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-xl font-medium rounded-tl-lg">Id</th>
                        <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-xl font-medium">Nombre</th>
                        <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-xl font-medium">Correo</th>
                        <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-xl font-medium">Teléfono</th>
                        <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-xl font-medium rounded-tr-lg">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each usuario}}
                    <tr>
                        <td class="px-4 py-2 bg-white text-center border-b-2 border-gray-200 shadow-b-xl">{{this.id}}
                        </td>
                        <td class="px-4 py-2 bg-white border-b-2 border-gray-200 shadow-b-xl text-center ">{{this.nombre}}</td>
                        <td class="px-4 py-2 bg-white border-b-2 border-gray-200 shadow-b-xl text-center ">
                            {{this.correo_electronico}}</td>
                        <td class="px-4 py-2 bg-white border-b-2 border-gray-200 shadow-b-xl text-center ">{{this.telefono}}</td>
                        <td class="px-4 py-2 bg-white text-center border-b-2 border-gray-200 shadow-b-xl">
                            {{this.status}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>

    <br>
    <h2 class="font-semibold text-2xl flex justify-center m-1 text-gray-700">Incidencia</h2>

    <!-- Sección de Incidencias -->
    <div class="flex justify-center mt-4">
        <div class="overflow-x-auto max-h-60 w-7/12 rounded-lg">
            <table class="w-full rounded-lg overflow-hidden">
                <thead>
                    <tr>
                        <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-xl font-medium rounded-tl-lg">Folio</th>
                        <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-xl font-medium ">Asunto</th>
                        <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-xl font-medium">Tipo</th>
                        <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-xl font-medium">Status</th>
                        <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-xl font-medium rounded-tr-lg text-center">
                            Descripción</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each incidencia}}
                    <tr>
                        <td class="px-4 py-2 bg-white text-center border-b-2 border-gray-200 shadow-b-xl">{{this.folio}}
                        </td>
                        <td class="px-4 py-2 bg-white border-b-2 border-gray-200 shadow-b-xl text-center ">{{this.asunto}}</td>
                        <td class="px-4 py-2 bg-white border-b-2 border-gray-200 shadow-b-xl text-center ">{{this.tipo}}</td>
                        <td class="px-4 py-2 bg-white border-b-2 border-gray-200 shadow-b-xl text-center ">{{this.status}}</td>
                        <td class="px-4 py-2 bg-white border-b-2 border-gray-200 shadow-b-xl text-center">
                            {{this.descripcion}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>


    <!-- Sección de seguimiento -->
    <br>
    {{#if segui}}
    <center>
        <h1 class="font-semibold text-4xl flex justify-center m-5">No hay seguimientos registrados</h1>
    </center>
    {{else}}
    <h2 class="font-semibold text-2xl flex justify-center m-1 text-gray-700">Seguimientos</h2>

    <div class="flex justify-center mt-4">
        <!-- Contenedor para el input de búsqueda con el icono de lupa -->
        <div class="relative w-9/12">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3">
                <i class="fas fa-search text-gray-500"></i> <!-- Ícono de lupa -->
            </span>
            <input type="text" id="searchInput" onkeyup="searchComments()" placeholder="Buscar comentario"
                class="border border-gray-200 text-lg placeholder-gray-500 p-2 pl-10 mb-0 focus:bg-white hover:bg-gray-300 w-full rounded-lg bg-white">
        </div>
    </div>

    <div class="flex justify-center w-9/12 mx-auto max-w-7xl"> 
            <div class="overflow-x-auto rounded-lg mb-10 w-full max-h-80">
                <table class="w-full " id="condominosTable"> 
                    <thead class="sticky top-0">
                    <tr>
                        <th id="contenedorFlecha" style="cursor: pointer;" class="px-4 {{!-- py-4 --}} bg-white border-b-2 border-gray-400 text-xl font-medium rounded-tl-lg ">
                            <span class="inline-flex items-center space-x-1">
                                <p> Movimiento </p>
                                {{!-- &nbsp; --}}
                                <a href="#" id="flechaDesc" data-order="desc">&darr;</a>
                                <a href="#" id="flechaAsc" data-order="asc">&uarr;</a>
                            </span>
                        </th>                        
                        <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-xl font-medium">Empleado</th>
                        <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-xl font-medium">Comentario</th>
                        <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-xl font-medium">Status</th>
                        <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-xl font-medium">Fecha</th>
                        <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-xl font-medium rounded-tr-lg">Evidencia
                        </th>
                    </tr>
                </thead>
                <tbody id="tablaSeguimiento">
                    {{#each datos}}
                    <tr class="dataRow">
                        </td>
                        <td class="px-4 py-2 bg-white  text-center border-b-2 border-gray-200 shadow-b-xl">{{this.movimiento}}</td>
                        <td class="px-4 py-2 bg-white  text-center border-b-2 border-gray-200 shadow-b-xl">{{this.empleado}}</td>
                        <td class="px-4 py-2 bg-white  text-center border-b-2 border-gray-200 shadow-b-xl">{{this.comentario}}</td>
                        <td class="px-4 py-2 bg-white  text-center border-b-2 border-gray-200 shadow-b-xl">{{this.status}}</td>
                        <td class="px-4 py-2 bg-white  text-center border-b-2 border-gray-200 shadow-b-xl">{{this.fecha}}</td>
                        <td class="px-4 py-2 bg-white text-center border-b-2 border-gray-200 shadow-b-xl">
                            {{#if this.evidencia}}
                            <img src="{{this.evidencia}}" alt="Evidencia" class="w-16 h-16 object-cover rounded-sm mx-auto"
                                onclick="mostrarImagen(this.src)">
                            {{else}}
                            No hay evidencia
                            {{/if}}
                        </td>
                    </tr>
                    {{/each}}
                    <tr id="noResultsRow" style="display:none;">
                        <td colspan="7" class="text-center p-4 bg-gray-200">No se encontraron comentarios</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    {{/if}}

    <div class="flex justify-center m-5">
        <h1 class="font-semibold text-4xl flex justify-center m-5">Alta</h1>
    </div>
    <!-- Formulario para agregar incidencia -->
    <div class="mx-auto my-8 p-4 bg-white w-full sm:w-5/6 md:w-4/6 lg:w-2/3 xl:w-1/3 border rounded-lg shadow-lg">
        <form action="/altaSeguimiento" method="POST" enctype="multipart/form-data">
            <label for="descripcion">Comentario</label>
            <br>
            <textarea name="comentario" id="comentario" placeholder="Comentario"
                class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">{{data.comentario}}</textarea>
            <br>

            <label for="tipoUsuario">Filtro de persona seleccionada:</label>
            <br>
            <select id="tipoUsuario" name="tipoUsuario" >
                <option value="">Seleccionar</option>
                <option value="2">Administrador</option>
                <option value="3">Condomino</option>
                <option value="4">Vigilante</option>
            </select>
            <br>

            <label for="empleado">Persona seleccionada</label>
            <br>
            <select id="empleado" name="empleado"
                class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                <option value="" selected></option>
                {{#each empleado}}
                <option name="{{this.tipo_usuario}}" value="{{this.id_usuario}}">{{this.nombre}}</option>
                {{/each}}
            </select>

            <label for="fecha"> <i class="fas fa-calendar"></i>Fecha</label>
            <input type="date" id="fecha" name="fecha" required
                class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300"
                value="{{data.fecha}}">

            <label for="status">Status</label>
            <select id="status" name="status"
                class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                {{#each status}}
                {{#isEqual this.correcto 2}}
                <option value="{{this.id_status_seguimiento }}" selected>{{this.descripcion}}</option>
                {{else}}
                <option value="{{this.id_status_seguimiento }}">{{this.descripcion}}</option>
                {{/isEqual}}
                {{/each}}
            </select>

            <label for="imagen">Imagen de Evidencia</label>
            <input type="file" id="imagen" name="imagen" accept=".png, .jpg, .jpeg, .pdf"
                class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
            <!--Sección para mostrar errores-->
            {{#if error}}
            <p class="text-red-500 font-bold text-lg my-3">*{{{error}}}</p>
            {{/if}}

            <div class="flex justify-center">
                <button type="submit"
                    class="bg-gray-600 text-white px-4 py-2 rounded-md hover:bg-gray-800 focus:bg-gray-900">Agregar
                    seguimiento</button>
            </div>
        </form>
        <script>
            // Mostrar alerta si hay un mensaje de error
            const errorMessage = '{{error}}'; // Aquí se pasa el mensaje de error desde el backend
            if (errorMessage) {
                alert(errorMessage);
            }
        </script>
    </div>
    </div>
    <script src="fecha.js"></script>
    <script>
        function searchComments() {
            const searchInput = document.getElementById('searchInput').value.toLowerCase();
            const rows = document.querySelectorAll('#seguimientosTable tbody tr.dataRow');
            const noResultsRow = document.getElementById('noResultsRow');
            let found = false;

            rows.forEach(row => {
                const comentario = row.querySelector('td:nth-child(4)').textContent.toLowerCase();
                if (comentario.includes(searchInput)) {
                    row.style.display = '';
                    found = true;
                } else {
                    row.style.display = 'none';
                }
            });

            // Mostrar mensaje si no se encontraron comentarios
            if (found) {
                noResultsRow.style.display = 'none';
            } else {
                noResultsRow.style.display = '';
            }
        }
        // Abre una nueva ventana con la imagen en tamaño completo
        function mostrarImagen(src) {
            window.open(src, "_blank");
        }

        $(document).ready(function () {
            $('#empleado').select2({
                placeholder: "Seleccione un empleado",
                allowClear: true,
                language: {
                    noResults: function () {
                        return "No se encontraron resultados";
                    }
                }
            });
        });

        document.getElementById('contenedorFlecha').addEventListener('click', function (event) {
            event.preventDefault();

            // flechas
            let abajo = document.getElementById('flechaDesc');
            let arriba = document.getElementById('flechaAsc');

            let orden; // Definir la variable "orden"

            // Verificar si está en descendente
            if (abajo.getAttribute('data-order') === 'desc') {
                // Cambio a orden ascendente
                abajo.innerHTML = '&uarr;';
                abajo.setAttribute('data-order', 'asc');
                orden = 'asc'; // Cambiar el valor de "orden"

                // Cambiar arriba a descendente
                arriba.innerHTML = '&darr;';
                arriba.setAttribute('data-order', 'desc');
            } else {
                // Cambio a orden descendente
                abajo.innerHTML = '&darr;';
                abajo.setAttribute('data-order', 'desc');
                orden = 'desc'; // Cambiar el valor de "orden"

                // Cambiar arriba a ascendente
                arriba.innerHTML = '&uarr;';
                arriba.setAttribute('data-order', 'asc');
            }

            let tbody = document.getElementById('tablaSeguimiento');
            let filas = Array.from(tbody.getElementsByTagName('tr'));

            // Ordenar las filas en base a la primera columna (FOLIO)
            filas.sort(function (a, b) {
                let valorA = a.getElementsByTagName('td')[0].innerText;
                let valorB = b.getElementsByTagName('td')[0].innerText;

                if (orden === 'asc') {
                    return valorA.localeCompare(valorB, undefined, { numeric: true });
                } else {
                    return valorB.localeCompare(valorA, undefined, { numeric: true });
                }
            });

            // Limpiar el tbody y agregar las filas ordenadas
            tbody.innerHTML = '';
            filas.forEach(function (fila) {
                tbody.appendChild(fila);
            });
        });

    </script>


    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const tipoUsuarioSelect = document.getElementById('tipoUsuario');
            const empleadoSelect = document.getElementById('empleado');
            const empleados = [
                {{#each empleado}}
                    { id: "{{this.id_usuario}}", nombre: "{{this.nombre}}", tipo: "{{this.tipo_usuario}}" },
                {{/each}}
            ];  

            tipoUsuarioSelect.addEventListener('change', (event) => {
                const selectedTipo = event.target.value;

                // Limpiar el select de empleados
                empleadoSelect.innerHTML = '<option value="" selected></option>'; // Opciones vacías por defecto

                // Filtrar empleados según el tipo seleccionado
                const filteredEmpleados = empleados.filter(emp => emp.tipo === selectedTipo || selectedTipo === "");

                // Agregar opciones al select de empleados
                filteredEmpleados.forEach(emp => {
                    const option = document.createElement('option');
                    option.value = emp.id;
                    option.textContent = emp.nombre;
                    empleadoSelect.appendChild(option);
                });
            });
        });
    </script>
    <script src="imagen.js"></script>
</body>

</html>
{{else}}
<div style="display: flex; justify-content: center; align-items: center; height: 100vh;">
    <h1 style="font-size: 3em;">La sesión ha expirado. Por favor, inicie la sesión nuevamente.</h1>
</div>
{{/if}}