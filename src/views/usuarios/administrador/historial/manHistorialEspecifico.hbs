{{#if name}}
<!DOCTYPE html>
<html lang="en">

<head>
</head>

<body>
    {{!-- <div class="border-b-2 border-gray-300 my-3"></div> --}}

    <a href="/renderHistorial"
        class="font-semibold text-4xl hover:text-gray-400 flex justify-center pt-4 pb-8">Historial</a>

    <a href="renHistorialCampos-{{ruta}}E">
        <p class="font-semibold text-2xl sm:text-3xl md:text-4xl hover:text-gray-400 flex justify-center pt-2 sm:pt-4"
            title="Página para la consulta específica de {{campo}}">
            Específico de {{ruta}}
        </p>
    </a>
    <div class="border-b-2 border-gray-300 w-2/6 mx-auto mt-1 mb-3 pt-4"></div>

    <div class="pb-8 text-center pt-7">
        <a href="renHistorialCampos-{{ruta}}G"
            class=" mx-auto rounded-md bg-gray-500 text-white hover:bg-gray-600 focus:bg-gray-700 font-medium text-base py-3 px-6 text-center">
            Ir a general de {{ruta}}
        </a>
    </div>

    <!-- Formulario para pago -->
    <h2 class="font-semibold text-2xl pt-3 pb-7 text-center">Formulario para historial de {{ruta}} especifíco</h2>

    <div class="flex justify-center mb-8 px-4 md:px-8">
        <div class="w-full sm:w-10/12 md:w-8/12 lg:w-6/12 xl:w-4/12">
            <div class="bg-white p-4 border rounded-lg shadow-lg text-base sm:text-lg">
                <form action="/consultaEspesifica" method="POST" class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    <input type="hidden" name="campo" value="{{campo}}" />
                    {{#each formFields}}
                    <div class="p-2 {{this.colSpan}}">
                        {{#isEqual this.type "radio"}}
                        <!-- Renderizar radio buttons con las opciones correctas -->
                        <div class="flex flex-wrap items-center space-x-2">
                            <label class="text-base sm:text-lg">
                                {{#if this.icon}}
                                <i class="{{this.icon}}"></i>
                                {{/if}}
                                {{this.label}}
                            </label>
                            {{#each this.options}}
                            <div class="flex items-center">
                                <input type="radio" name="{{../name}}" value="{{this.value}}"
                                    id="{{../name}}_{{this.value}}" class="mr-2" />
                                <label for="{{../name}}_{{this.value}}"
                                    class="text-base sm:text-lg">{{this.text}}</label>
                            </div>
                            {{/each}}
                        </div>
                        {{else isEqual this.type "select"}}
                        <!-- Renderizar select con las opciones correctas -->
                        <label for="{{this.name}}" class="block text-base sm:text-lg">
                            {{#if this.icon}}
                            <i class="{{this.icon}}"></i>
                            {{/if}}
                            {{this.label}}
                        </label>
                        <select name="{{this.name}}" id="{{this.name}}"
                            class="border border-gray-200 w-full text-base sm:text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                            <option value=""></option>
                            {{#each this.options}}
                            <option value="{{this.value}}">{{this.text}}</option>
                            {{/each}}
                        </select>
                        {{else}}
                        <!-- Renderizar cualquier otro campo de texto -->
                        <label for="{{this.name}}" class="block text-base sm:text-lg">
                            {{#if this.icon}}
                            <i class="{{this.icon}}"></i>
                            {{/if}}
                            {{this.label}}
                        </label>
                        <input type="{{this.type}}" name="{{this.name}}" value="{{this.data}}"
                            placeholder="{{this.label}}" class="border border-gray-200 w-full text-base sm:text-lg p-2">
                        {{/isEqual}}
                    </div>
                    {{/each}}
                    <div class="col-span-1 md:col-span-2">
                        <button id="enviar" type="submit"
                            class="rounded-md bg-gray-500 w-full text-white hover:bg-gray-600 focus:bg-gray-700 font-medium text-lg sm:text-xl px-6 py-2 block text-center">
                            Realizar consulta
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Popup de error -->
    <div id="info-popup" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden">
        <div class="bg-white rounded-lg p-6 shadow-lg">
            <div class="mb-4">
                <p>Algo ha salido mal, inténtalo de nuevo</p>
            </div>
            <div class="flex justify-end">
                <button id="close-modal"
                    class="px-4 py-2 bg-red-500 text-white rounded hover:bg-red-600">Cerrar</button>
            </div>
        </div>
    </div>
    <script>
        // Mostrar mensaje de error personalizado si hay un mensaje de error
        const errorMessage = '{{error}}'; // Asumiendo que 'errorT' contiene el mensaje de error desde el backend
        if (errorMessage) {
            const errorContainer = document.createElement('div');
            errorContainer.setAttribute('role', 'alert');
            errorContainer.innerHTML = `
        <div class="border border-t-0 border-red-400 rounded-b bg-red-100 px-4 py-3 text-red-700">
            <p>${errorMessage}</p>
        </div>
    `;
            // Colocar el mensaje de error justo antes del formulario
            const form = document.querySelector('form');
            form.parentNode.insertBefore(errorContainer, form);

            // Mostrar el popup solo si hay error
            const popup = document.getElementById('info-popup');
            popup.classList.remove('hidden'); // Mostrar el popup si hay error
        }

        // Cerrar el popup cuando se haga clic en "Cancelar"
        document.getElementById('close-modal').addEventListener('click', function () {
            const popup = document.getElementById('info-popup');
            popup.classList.add('hidden'); // Ocultar el popup
        });

        // Cerrar el popup cuando se haga clic en "Confirmar"
        document.getElementById('confirm-button').addEventListener('click', function () {
            const popup = document.getElementById('info-popup');
            popup.classList.add('hidden'); // Ocultar el popup
        });

    </script>

    <script>
        $(document).ready(function () {
            // Aplica select2 a todos los elementos <select> en el documento
            $('select').select2({
                placeholder: "Seleccione una opción",  // Placeholder genérico
                allowClear: true,
                language: {
                    noResults: function () {
                        return "No se encontraron resultados";
                    }
                }
            });
        });
    </script>

    <style>
        /* Ajustes de altura para todos los select2 */
        .select2-container--default .select2-selection--single {
            height: 3rem;
            /* Ajusta este valor según el tamaño que desees */
            display: flex;
            align-items: center;
            /* Centra el texto verticalmente */
            position: relative;
            /* Posición relativa para manejar la x */
        }

        .select2-container .select2-selection--single .select2-selection__rendered {
            line-height: 3rem;
            /* Ajusta este valor al mismo valor que el height */
        }

        .select2-container .select2-selection--single .select2-selection__arrow {
            height: 3rem;
            /* Ajusta el ícono del desplegable */
        }

        /* Mover la X (para limpiar la selección) al lado derecho */
        .select2-container--default .select2-selection--single .select2-selection__clear {
            position: absolute;
            right: 10px;
            /* Ajusta la distancia del borde derecho */
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            /* Cambia el cursor a pointer para mayor claridad */
        }
    </style>

</body>

</html>
{{else}}
<div style="display: flex; justify-content: center; align-items: center; height: 100vh;">
    <h1 style="font-size: 3em;">La sesión ha expirado. Por favor, inicie la sesión nuevamente.</h1>
</div>
{{/if}}