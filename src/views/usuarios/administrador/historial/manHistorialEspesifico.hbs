{{#if name}}
<!DOCTYPE html>
<html lang="en">

<head>
</head>

<body>
    <a href="/renHistorial">
        <h1 class="font-semibold text-4xl hover:text-gray-400 flex justify-center pt-4 pb-8">Historial</h1>
    </a>
    <p class="font-semibold text-3xl flex justify-center">Espesifico</p>
    {{#isEqual campo "pagos"}}
    <!-- Formulario para pago -->
    <div class="flex justify-center">
        <div class="w-4/12">
            <h2 class="font-semibold text-2xl pt-3 text-center">Formulario para historial de pagos espesifico</h2>
            <div class="bg-white p-4 border rounded-lg shadow-lg text-lg">
                <form action="/consultaEspesifica" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <input type="hidden" name="campo" value="{{campo}}" />
                    <!-- Nombre y Apellidos -->
                    <div class="md:col-span-1">
                        <label for="fecha"><i class="fas fa-calendar"></i> Fecha de registro</label>
                        <input type="date" id="fecha" name="fecha" placeholder="YYYY-MM" value="{{data.fecha}}"
                            class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-2">
                    </div>
                    <div class="md:col-span-1">

                    </div>
                    <div class="md:col-span-1">
                        <label for="Mes"><i class="fas fa-calendar"></i> Mes inicio</label>
                        <select id="mesI" name="mesI"
                            class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                            {{#each meses}}
                            {{#isEqual this.mes this.correcto}}
                            <option value="{{this.mes}} " selected>{{this.descripcion}}</option>
                            {{else}}
                            <option value="{{this.mes}}">{{this.descripcion}}</option>
                            {{/isEqual}}
                            {{/each}}
                        </select>
                    </div>
                    <div class="md:col-span-1">
                        <label for="Año"><i class="fas fa-calendar"></i> Año inicio</label>
                        <select id="añoI" name="añoI"
                            class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                            {{#each años}}
                            {{#isEqual this.correcto 1}}
                            <option value="{{this.año}}" selected>{{this.año}}</option>
                            {{else}}
                            <option value="{{this.año}}">{{this.año}}</option>
                            {{/isEqual}}
                            {{/each}}
                        </select>
                    </div>

                    <div class="md:col-span-1">
                        <label for="Mes"><i class="fas fa-calendar"></i> Mes final</label>
                        <select id="mesF" name="mesF"
                            class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                            {{#each meses}}
                            {{#isEqual this.mes this.correcto}}
                            <option value="{{this.mes}} " selected>{{this.descripcion}}</option>
                            {{else}}
                            <option value="{{this.mes}}">{{this.descripcion}}</option>
                            {{/isEqual}}
                            {{/each}}
                        </select>
                    </div>
                    <div class="md:col-span-1">
                        <label for="AñoF"><i class="fas fa-calendar"></i> Año final</label>
                        <select id="añoF" name="añoF"
                            class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                            {{#each años}}
                            {{#isEqual this.correcto 1}}
                            <option value="{{this.año}}" selected>{{this.año}}</option>
                            {{else}}
                            <option value="{{this.año}}">{{this.año}}</option>
                            {{/isEqual}}
                            {{/each}}
                        </select>
                    </div>

                    <div class="md:col-span-1">
                        <label for="Tipo_pago"><i class="fas fa-calendar"></i> Tipo pago</label>
                        <select id="tipoPago" name="tipoPago"
                            class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                            <option value="" selected></option>
                            {{#each pagoDatos.tiposPago}}
                            <option value="{{this.id_tipo_pago}}">{{this.tipo_pago_descripcion}}</option>
                            {{/each}}
                        </select>
                    </div>

                    <div class="md:col-span-1">
                        <label for="Tipo_propiedad"><i class="fas fa-calendar"></i> Tipo propiedad</label>
                        <select id="tipoPropiedad" name="tipoPropiedad"
                            class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                            <option value="" selected></option>
                            {{#each pagoDatos.tiposPropiedad}}
                            <option value="{{this.id_tipo_propiedad}}">{{this.tipo_propiedad_descripcion}}</option>
                            {{/each}}
                        </select>
                    </div>

                    <div class="md:col-span-1">
                        <label for="adm"><i class="fas fa-calendar"></i> Administrador</label>
                        <select id="adm" name="adm"
                            class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                            <option value="" selected></option>
                            {{#each pagoDatos.administradores}}
                            <option value="{{this.id_administrador}}">{{this.administrador}}</option>
                            {{/each}}
                        </select>
                    </div>

                    <div class="md:col-span-1">
                        <label for="condomino"><i class="fas fa-calendar"></i> Condomino</label>
                        <select id="condomino" name="condomino"
                            class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                            <option value="" selected></option>
                            {{#each pagoDatos.condominos}}
                            <option value="{{this.id_condomino}}">{{this.condomino}}</option>
                            {{/each}}
                        </select>
                    </div>

                    <div class="md:col-span-2">
                        <label for="referencia"><i class="fas fa-calendar"></i> Referencia</label>
                        <select id="referencia" name="referencia"
                            class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                            <option value="" selected></option>
                            {{#each pagoDatos.referencias}}
                            <option value="{{this.referencia}}">{{this.referencia}}</option>
                            {{/each}}
                        </select>
                    </div>

                    <div class="md:col-span-2">
                        <label for="propiedad"><i class="fas fa-calendar"></i> Propiedades</label>
                        <select id="propiedad" name="propiedad"
                            class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                            <option value="" selected></option>
                            {{#each pagoDatos.propiedades}}
                            <option value="{{this.id_propiedad}}">{{this.propiedad_descripcion}}</option>
                            {{/each}}
                        </select>
                    </div>
                    <div class="md:col-span-2">

                        <button type="submit"
                            class="rounded-md bg-gray-500 w-full text-white hover:bg-gray-600 focus:bg-gray-700 font-medium text-base px-6 py-3 block mt-4 mb-2 text-center">Realizar
                            consulta</button>
                    </div>
                    </tbody>
                    </table>
                </form>
            </div>
        </div>
    </div>
    {{/isEqual}}
    {{#isEqual campo "incidencias"}}
    <p>incidencias</p>
    {{/isEqual}}
    {{#isEqual campo "seguimientos"}}
    <p>propiedades</p>
    {{/isEqual}}

    
    <!-- Popup de error -->
    <div id="info-popup" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden">
        <div class="bg-white rounded-lg p-6 shadow-lg">
            <div class="mb-4">
                <p>Algo ha salido mal, intentalo de nuevo</p>
            </div>
            <div class="flex justify-end">
                <button id="close-modal"
                    class="px-4 py-2 bg-red-500 text-white rounded hover:bg-red-600">Cerrar</button>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            // Aplica select2 a todos los elementos <select> en el documento
            $('select').select2({
                placeholder: "Seleccione una opción",  // Placeholder genérico
                allowClear: true,
                language: {
                    noResults: function () {
                        return "No se encontraron resultados";
                    }
                }
            });
        });
    </script>
    <script>
        // Mostrar mensaje de error personalizado si hay un mensaje de error
        const errorMessage = '{{error}}'; // Asumiendo que 'errorT' contiene el mensaje de error desde el backend
        if (errorMessage) {
            const errorContainer = document.createElement('div');
            errorContainer.setAttribute('role', 'alert');
            errorContainer.innerHTML = `
        <div class="border border-t-0 border-red-400 rounded-b bg-red-100 px-4 py-3 text-red-700">
            <p>${errorMessage}</p>
        </div>
    `;
            // Colocar el mensaje de error justo antes del formulario
            const form = document.querySelector('form');
            form.parentNode.insertBefore(errorContainer, form);

            // Mostrar el popup solo si hay error
            const popup = document.getElementById('info-popup');
            popup.classList.remove('hidden'); // Mostrar el popup si hay error
        }

        // Cerrar el popup cuando se haga clic en "Cancelar"
        document.getElementById('close-modal').addEventListener('click', function () {
            const popup = document.getElementById('info-popup');
            popup.classList.add('hidden'); // Ocultar el popup
        });

        // Cerrar el popup cuando se haga clic en "Confirmar"
        document.getElementById('confirm-button').addEventListener('click', function () {
            const popup = document.getElementById('info-popup');
            popup.classList.add('hidden'); // Ocultar el popup
        });

    </script>

    <style>
        /* Ajustes de altura para todos los select2 */
        .select2-container--default .select2-selection--single {
            height: 3rem;
            /* Ajusta este valor según el tamaño que desees */
            display: flex;
            align-items: center;
            /* Centra el texto verticalmente */
            position: relative;
            /* Posición relativa para manejar la x */
        }

        .select2-container .select2-selection--single .select2-selection__rendered {
            line-height: 3rem;
            /* Ajusta este valor al mismo valor que el height */
        }

        .select2-container .select2-selection--single .select2-selection__arrow {
            height: 3rem;
            /* Ajusta el ícono del desplegable */
        }

        /* Mover la X (para limpiar la selección) al lado derecho */
        .select2-container--default .select2-selection--single .select2-selection__clear {
            position: absolute;
            right: 10px;
            /* Ajusta la distancia del borde derecho */
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            /* Cambia el cursor a pointer para mayor claridad */
        }
    </style>

</body>

</html>
{{else}}
<div style="display: flex; justify-content: center; align-items: center; height: 100vh;">
    <h1 style="font-size: 3em;">La sesión ha expirado. Por favor, inicie la sesión nuevamente.</h1>
</div>
{{/if}}