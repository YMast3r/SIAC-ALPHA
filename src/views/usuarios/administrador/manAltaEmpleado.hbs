{{#if name}}
<!DOCTYPE html>
<html lang="es">
<body>
    <h1 class="text-2xl m-5 font-bold text-center">Empleados Registrados</h1>

    <!-- Campo de busqueda -->
    <div class="flex justify-center pt-2 mb-0 w-9/12 mx-auto">
        <div class="relative w-full ">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3">
                <i class="fas fa-search text-gray-500"></i> <!-- Ícono de lupa -->
            </span>
            <input type="text" id="search" placeholder="Buscar nombre en Empleados..."
                class=" bg-white border border-gray-200 text-lg placeholder-gray-500 p-2 mb-0 focus:bg-white hover:bg-gray-300 w-full rounded-lg pl-10">
        </div>
    </div>

    <div class="flex justify-center w-9/12 mx-auto ">
        <div class="overflow-x-auto rounded-lg mb-10 w-full max-h-60">
            <table class="w-full">
                <thead class="sticky top-0 bg-white">
                    <tr>
                        <th class="px-4 py-2 border-b-2 border-gray-400 text-lg font-medium">Nombre</th>
                        <th class="px-4 py-2 border-b-2 border-gray-400 text-lg font-medium">Apellidos</th>
                        <th class="px-4 py-2 border-b-2 border-gray-400 text-lg font-medium">Correo Electrónico</th>
                        <th class="px-4 py-2 border-b-2 border-gray-400 text-lg font-medium">Teléfono</th>
                        <th class="px-4 py-2 border-b-2 border-gray-400 text-lg font-medium">Tipo de Empleado</th>
                        <th class="px-4 py-2 border-b-2 border-gray-400 text-lg font-medium">Salario</th>
                        <th class="px-4 py-2 border-b-2 border-gray-400 text-lg font-medium">Fecha de Contratación</th>
                        <th class="px-4 py-2 border-b-2 border-gray-400 text-lg font-medium">Dirección</th>
                        <th class="px-4 py-2 border-b-2 border-gray-400 text-lg font-medium">Ciudad</th>
                        <th class="px-4 py-2 border-b-2 border-gray-400 text-lg font-medium">Estado</th>
                        <th class="px-4 py-2 border-b-2 border-gray-400 text-lg font-medium">Código Postal</th>
                        <th class="px-4 py-2 border-b-2 border-gray-400 text-lg font-medium">Seguridad Social</th>
                        <th class="px-4 py-2 border-b-2 border-gray-400 text-lg font-medium">Nacionalidad</th>
                        <th class="px-4 py-2 border-b-2 border-gray-400 text-lg font-medium">Género</th>
                        <th class="px-4 py-2 border-b-2 border-gray-400 text-lg font-medium">Estado Civil</th>
                    </tr>
                </thead>
                <tbody id="tabla">
                    {{#each empleados}}
                    <tr class="bg-white">
                        <td class="px-4 py-2 border-b-2 border-gray-200 text-center">{{this.nombre}}</td>
                        <td class="px-4 py-2 border-b-2 border-gray-200 text-center">{{this.apellidos}}</td>
                        <td class="px-4 py-2 border-b-2 border-gray-200 text-center">{{this.correo_electronico}}</td>
                        <td class="px-4 py-2 border-b-2 border-gray-200 text-center">{{this.telefono}}</td>
                        <td class="px-4 py-2 border-b-2 border-gray-200 text-center">{{this.tipo_empleado}}</td>
                        <td class="px-4 py-2 border-b-2 border-gray-200 text-center">{{this.salario}}</td>
                        <td class="px-4 py-2 border-b-2 border-gray-200 text-center">{{this.fecha_contratacion}}</td>
                        <td class="px-4 py-2 border-b-2 border-gray-200 text-center">{{this.direccion}}</td>
                        <td class="px-4 py-2 border-b-2 border-gray-200 text-center">{{this.ciudad}}</td>
                        <td class="px-4 py-2 border-b-2 border-gray-200 text-center">{{this.estado}}</td>
                        <td class="px-4 py-2 border-b-2 border-gray-200 text-center">{{this.codigo_postal}}</td>
                        <td class="px-4 py-2 border-b-2 border-gray-200 text-center">{{this.numero_seguridad_social}}</td>
                        <td class="px-4 py-2 border-b-2 border-gray-200 text-center">{{this.nacionalidad}}</td>
                        <td class="px-4 py-2 border-b-2 border-gray-200 text-center">{{this.genero}}</td>
                        <td class="px-4 py-2 border-b-2 border-gray-200 text-center">{{this.estado_civil}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>


    <div class="mx-auto my-8 p-4 bg-white w-9/12 {{!-- sm:w-5/6 md:w-4/6 lg:w-2/3 xl:w-1/3 --}} border rounded-lg shadow-lg">
        <h1 class="text-2xl m-5 font-bold text-center">Registra un empleado</h1>
        <form id="registroForm" action="/registrarEmpleado" method="POST" class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
                <label for="nombre"><i class="fas fa-user"></i> Nombre(s):</label>
                <input type="text" id="nombre" name="nombre" required
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
            </div>
            <div>
                <label for="apellidos"><i class="fas fa-user"></i> Apellidos:</label>
                <input type="text" id="apellidos" name="apellidos" required
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
            </div>
            <div>
                <label for="fecha_nacimiento"><i class="fas fa-calendar"></i> Fecha de Nacimiento:</label>
                <input type="date" id="fecha_nacimiento" name="fecha_nacimiento" required
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
            </div>
            <div>
                <label for="tipo_empleado"><i class="fas fa-user-tie"></i> Tipo de Empleado:</label>
                <select id="tipo_empleado" name="tipo_empleado" required
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
                    <option value="">Seleccione</option>
                    {{#each tiposEmpleado}}
                    <option value="{{this.id_tipo_empleado}}">{{this.descripcion}}</option>
                    <!-- Ajusta según tu estructura -->
                    {{/each}}
                </select>
            </div>
            <div>
                <label for="salario"><i class="fas fa-dollar-sign"></i> Salario:</label>
                <input type="number" id="salario" name="salario" step="0.01" required
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
            </div>
            <div>
                <label for="fecha_contratacion"><i class="fas fa-calendar"></i> Fecha de Contratación:</label>
                <input type="date" id="fecha_contratacion" name="fecha_contratacion" required
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
            </div>
            <div>
                <label for="telefono"><i class="fas fa-phone"></i> Teléfono:</label>
                <div class="relative">
                    <input type="tel" name="telefono" class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10" id="telefono" placeholder="Teléfono (ej. 449 223 9955)" value="{{formData.telefono}}" required>
                </div>    
                    <small id="telefonoError" class="form-text text-danger text-red-600"></small>
            </div>
            <div>
                <label for="correo_electronico"><i class="fas fa-envelope"></i> Correo Electrónico:</label>
                <div class="relative">
                    <input type="email" name="correo_electronico" class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10" placeholder="Correo electrónico" id="correo_electronico" value="{{formData.correo_electronico}}" required>
                </div> 
                <small id="correoError" class="form-text text-danger text-red-600"></small>
            </div>
            <div>
                <label for="password"><i class="fas fa-lock">&nbsp;</i> Contraseña:</label>
                    <div class="relative">
                        <input type="password" name="password"  id="passwordInicio" placeholder="Contraseña" class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10" value="{{formData.password}}" required >

                        <div class="absolute right-2 top-1/2 transform -translate-y-1/2">
                            {{!-- ojo abierto --}}
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-eye" width="30" height="30" viewBox="0 0 24 24" stroke-width="1.5" stroke="#000000" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
                                <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" />
                            </svg>

                            {{!-- ojo cerrado --}}
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-eye-closed" width="30" height="30" viewBox="0 0 24 24" stroke-width="1.5" stroke="#000000" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                <path d="M21 9c-2.4 2.667 -5.4 4 -9 4c-3.6 0 -6.6 -1.333 -9 -4" />
                                <path d="M3 15l2.5 -3.8" />
                                <path d="M21 14.976l-2.492 -3.776" />
                                <path d="M9 17l.5 -4" />
                                <path d="M15 17l-.5 -4" />
                            </svg>
                        </div>
                    </div>
            </div>
            <div>
                <label for="confirm_password"><i class="fas fa-lock">&nbsp;</i> Confirmar Contraseña:</label>
                <div class="relative">
                    <input type="password" name="confirm_password"  id="confirm_password" placeholder="Contraseña" class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10" value="{{formData.confirm_password}}" required >

                    <div class="absolute right-2 top-1/2 transform -translate-y-1/2">
                        {{!-- ojo abierto --}}
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-eye" width="30" height="30" viewBox="0 0 24 24" stroke-width="1.5" stroke="#000000" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
                            <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" />
                        </svg>

                        {{!-- ojo cerrado --}}
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-eye-closed" width="30" height="30" viewBox="0 0 24 24" stroke-width="1.5" stroke="#000000" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M21 9c-2.4 2.667 -5.4 4 -9 4c-3.6 0 -6.6 -1.333 -9 -4" />
                            <path d="M3 15l2.5 -3.8" />
                            <path d="M21 14.976l-2.492 -3.776" />
                            <path d="M9 17l.5 -4" />
                            <path d="M15 17l-.5 -4" />
                        </svg>
                    </div>
                </div>
            </div>
            <div>
                <label for="direccion"><i class="fas fa-map-marker-alt">&nbsp;</i> Dirección:</label>
                <input type="text" id="direccion" name="direccion" required
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
            </div>
            <div>
                <label for="ciudad"><i class="fas fa-city">&nbsp;</i> Ciudad:</label>
                <input type="text" id="ciudad" name="ciudad" required
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
            </div>
            <div>
                <label for="estado"><i class="fas fa-map-marked-alt">&nbsp;</i> Estado:</label>
                <input type="text" id="estado" name="estado" required
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
            </div>
            <div>
                <label for="codigo_postal"><i class="fas fa-map-marker-alt">&nbsp;</i> Código Postal:</label>
                <input type="text" id="codigo_postal" name="codigo_postal" required
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
            </div>
            <div>
                <label for="nss"><i class="fas fa-id-card"></i> Número de Seguridad Social:</label>
                <input type="text" id="nss" name="nss" required
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
            </div>
            <div>
                <label for="nacionalidad"><i class="fas fa-globe-americas"></i> Nacionalidad:</label>
                <input type="text" id="nacionalidad" name="nacionalidad" required
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
            </div>
            <div>
                <label for="genero"><i class="fas fa-venus-mars"></i> Género:</label>
                <select id="genero" name="genero" required
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
                    <option value="">Seleccione</option>
                    <option value="M">Masculino</option>
                    <option value="F">Femenino</option>
                </select>
            </div>
            <div>
                <label for="estado_civil"><i class="fas fa-user"></i> Estado Civil:</label>
                <select id="estado_civil" name="estado_civil" required
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
                    <option value="">Seleccione</option>
                    <option value="Soltero">Soltero/a</option>
                    <option value="Casado">Casado/a</option>
                    <option value="Divorciado">Divorciado/a</option>
                    <option value="Viudo">Viudo/a</option>
                </select>
            </div>
            <div class="col-span-3 flex justify-center">
                <button type="submit"
                    class="rounded-md bg-gray-500 w-full text-white hover:bg-gray-600 focus:bg-gray-700 font-medium text-xl px-6 py-2 block text-center">Registrar</button>
            </div>
        </form>
    </div>

    <script src="telefono.js"></script>
    <script src="correo.js"></script>
    <script src="ojo.js"></script>
    <script>
        document.getElementById('search').addEventListener('keyup', function () {
            let filter = this.value.toLowerCase();
            let rows = document.querySelectorAll('#tabla tr');
            let noResult = true;

            rows.forEach(row => {
                let nombre = row.cells[0].innerText.toLowerCase();
                if (nombre.includes(filter)) {
                    row.style.display = '';
                    noResult = false;
                } else {
                    row.style.display = 'none';
                }
            });

            document.getElementById('noResult').style.display = noResult ? '' : 'none';
        });
    </script>
</body>

</html>

{{else}}
    <div style="display: flex; justify-content: center; align-items: center; height: 100vh;">
        <h1 style="font-size: 3em;">La sesión ha expirado. Por favor, inicie la sesión nuevamente.</h1>
    </div>
{{/if}}