{{#if name}}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro de Empleado</title>
    <style>
        .input-error {
            border-color: red;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        table, th, td {
            border: 1px solid black;
        }
        th, td {
            padding: 10px;
            text-align: left;
        }
        th {
            background-color: #f2f2f2;
        }
    </style>
</head>
<body>
    <h1 class="text-2xl m-5 font-bold text-center">Empleados Registrados</h1>
    
    <!-- Tabla de empleados -->
    <table>
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Apellidos</th>
                <th>Correo Electrónico</th>
                <th>Teléfono</th>
                <th>Tipo de Empleado</th>
                <th>Salario</th>
                <th>Fecha de Contratación</th>
                <th>Dirección</th>
                <th>Ciudad</th>
                <th>Estado</th>
                <th>Código Postal</th>
                <th>Seguridad Social</th>
                <th>Nacionalidad</th>
                <th>Género</th>
                <th>Estado Civil</th>
            </tr>
        </thead>
        <tbody>
            {{#each empleados}}
            <tr>
                <td>{{this.nombre}}</td>
                <td>{{this.apellidos}}</td>
                <td>{{this.correo_electronico}}</td>
                <td>{{this.telefono}}</td>
                <td>{{this.id_tipo_empleado}}</td>
                <td>{{this.salario}}</td>
                <td>{{this.fecha_contratacion}}</td>
                <td>{{this.direccion}}</td>
                <td>{{this.ciudad}}</td>
                <td>{{this.estado}}</td>
                <td>{{this.codigo_postal}}</td>
                <td>{{this.numero_seguridad_social}}</td>
                <td>{{this.nacionalidad}}</td>
                <td>{{this.genero}}</td>
                <td>{{this.estado_civil}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</body>

<body>
    <div class="mx-auto my-8 p-4 bg-white w-9/12 {{!-- sm:w-5/6 md:w-4/6 lg:w-2/3 xl:w-1/3 --}} border rounded-lg shadow-lg"></div>
    <h1 class="text-2xl m-5 font-bold text-center">Registra un empleado</h1>
    <form id="registroForm" action="/registrarEmpleado" method="POST" class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
            <label for="nombre"><i class="fas fa-user"></i> Nombre(s):</label>
            <input type="text" id="nombre" name="nombre" required class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
        </div>
        <div>
            <label for="apellidos"><i class="fas fa-user"></i> Apellidos:</label>
            <input type="text" id="apellidos" name="apellidos" required class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
        </div>
        <div>
            <label for="fecha_nacimiento"><i class="fas fa-calendar"></i> Fecha de Nacimiento:</label>
            <input type="date" id="fecha_nacimiento" name="fecha_nacimiento" required class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
        </div>
        <div>
            <label for="tipo_empleado"><i class="fas fa-user-tie"></i> Tipo de Empleado:</label>
            <select id="tipo_empleado" name="tipo_empleado" required class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
                <option value="">Seleccione</option>
                {{#each tiposEmpleado}}
                    <option value="{{this.id_tipo_empleado}}">{{this.descripcion}}</option> <!-- Ajusta según tu estructura -->
                {{/each}}
            </select>
        </div>
        <div>
            <label for="salario"><i class="fas fa-dollar-sign"></i> Salario:</label>
            <input type="number" id="salario" name="salario" step="0.01" required class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
        </div>
        <div>
            <label for="fecha_contratacion"><i class="fas fa-calendar"></i> Fecha de Contratación:</label>
            <input type="date" id="fecha_contratacion" name="fecha_contratacion" required class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
        </div>
        <div>
            <label for="telefono"><i class="fas fa-phone"></i> Teléfono:</label>
            <input type="tel" id="telefono" name="telefono" required class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
        </div>
        <div>
            <label for="correo_electronico"><i class="fas fa-envelope"></i> Correo Electrónico:</label>
            <input type="email" id="correo_electronico" name="correo_electronico" required class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
        </div>
        <div>
            <label for="password"><i class="fas fa-lock">&nbsp;</i> Contraseña:</label>
            <input type="password" id="password" name="password" required class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
        </div>
        <div>
            <label for="confirm_password"><i class="fas fa-lock">&nbsp;</i> Confirmar Contraseña:</label>
            <input type="password" id="confirm_password" name="confirm_password" required class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
        </div>
        <div>
            <label for="direccion"><i class="fas fa-map-marker-alt">&nbsp;</i> Dirección:</label>
            <input type="text" id="direccion" name="direccion" required class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
        </div>
        <div>
            <label for="ciudad"><i class="fas fa-city">&nbsp;</i> Ciudad:</label>
            <input type="text" id="ciudad" name="ciudad" required class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
        </div>
        <div>
            <label for="estado"><i class="fas fa-map-marked-alt">&nbsp;</i> Estado:</label>
            <input type="text" id="estado" name="estado" required class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
        </div>
        <div>
            <label for="codigo_postal"><i class="fas fa-map-marker-alt">&nbsp;</i> Código Postal:</label>
            <input type="text" id="codigo_postal" name="codigo_postal" required class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
        </div>
        <div>
            <label for="nss"><i class="fas fa-id-card"></i> Número de Seguridad Social:</label>
            <input type="text" id="nss" name="nss" required class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
        </div>
        <div>
            <label for="nacionalidad"><i class="fas fa-globe-americas"></i> Nacionalidad:</label>
            <input type="text" id="nacionalidad" name="nacionalidad" required class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
        </div>
        <div>
            <label for="genero"><i class="fas fa-venus-mars"></i> Género:</label>
            <select id="genero" name="genero" required class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
                <option value="">Seleccione</option>
                <option value="M">Masculino</option>
                <option value="F">Femenino</option>
            </select>
        </div>
        <div>
            <label for="estado_civil"><i class="fas fa-user"></i> Estado Civil:</label>
            <select id="estado_civil" name="estado_civil" required class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">
                <option value="">Seleccione</option>
                <option value="Soltero">Soltero/a</option>
                <option value="Casado">Casado/a</option>
                <option value="Divorciado">Divorciado/a</option>
                <option value="Viudo">Viudo/a</option>
            </select>
        </div>
        <div class="col-span-3 flex justify-center">
            <button type="submit" class="rounded-md bg-gray-500 w-full text-white hover:bg-gray-600 focus:bg-gray-700 font-medium text-xl px-6 py-2 block text-center">Registrar</button>
        </div>
    </form>
</div>


    <script src="telefono.js"></script>
    <script src="correo.js"></script>
    <script src="ojo.js"></script>
</body>
</html>

{{else}}
    <div style="display: flex; justify-content: center; align-items: center; height: 100vh;">
        <h1 style="font-size: 3em;">La sesión ha expirado. Por favor, inicie la sesión nuevamente.</h1>
    </div>
{{/if}}