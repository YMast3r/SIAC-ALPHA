{{#if name}}

<!DOCTYPE html>
<html lang="es">

<head>
    <script src="https://cdn.tailwindcss.com"></script><!--sirve para usar tailwind-->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    {{!-- LIBRERIAS --}}
    <link href="/select2/css/select2.min.css" rel="stylesheet" />
    <script src="/jquery/jquery.min.js"></script>
    <script src="/select2/js/select2.min.js"></script>
</head>

<body class="bg-indigo-200">

    <div>
        <a id="renderManPropiedad" href="/renderManPropiedad"
            class="font-semibold text-4xl hover:text-gray-400 flex justify-center m-5">Propiedades</a>

        <div id="propiedad" class="">
            <!-- Primera tabla -->
            <h2 class="font-medium text-2xl mb-4 text-center text-gray-700">Propiedad</h2>

            <!-- Campo de busqueda -->
            <div class="flex justify-center pt-2 mb-0 w-10/12 mx-auto">
                <div class="relative w-full ">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3">
                        <i class="fas fa-search text-gray-500"></i> <!-- Ícono de lupa -->
                    </span>
                    <input type="text" id="search" placeholder="Buscar dirección en Propiedades..."
                        class=" bg-white border border-gray-200 text-lg placeholder-gray-500 p-2 mb-0 focus:bg-white hover:bg-gray-300 w-full rounded-lg pl-10">
                </div>
            </div>

            <!-- Primera tabla -->
            <div class="flex justify-center mx-auto w-10/12 lg:w-10/12">
                <div class="overflow-x-auto max-h-80 mb-10 w-full border border-gray-200 rounded-lg shadow">
                    <table class="w-full text-sm md:text-base lg:text-lg">
                        <thead class="sticky top-0 bg-gray-100">
                            <tr>
                                <th id="contenedorFlecha" style="cursor: pointer;"
                                    class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium rounded-tl-lg text-xl">
                                    ID PROPIEDAD
                                    <span class="inline-flex items-center space-x-1">
                                        <a href="#" id="flechaDesc" data-order="desc">&darr;</a>
                                        <a href="#" id="flechaAsc" data-order="asc">&uarr;</a>
                                    </span>
                                </th>
                                <th
                                    class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-center text-xl">
                                    DIRECCIÓN
                                </th>
                                <th
                                    class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-center text-xl">
                                    CONDÓMINO</th>
                                <th
                                    class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-center rounded-tr-lg text-xl">
                                    TIPO PROPIEDAD</th>

                            </tr>
                        </thead>
                        <tbody id="propiedadTable">
                            {{#each propiedad}}
                            <tr>
                                <td
                                    class="px-4 py-2 bg-white text-center  border-b-2 border-gray-200 text-lg rounded-bl-lg">
                                    {{this.id_propiedad}}
                                </td>
                                <td class="px-6 py-2 bg-white border-b-2 border-gray-200 text-center text-lg">
                                    {{this.descripcion}}
                                </td>
                                <td class="px-4 py-2 bg-white border-b-2 border-gray-200 text-center  text-lg">
                                    {{this.condomino}}
                                </td>
                                <td
                                    class="px-4 py-2 bg-white border-b-2 border-gray-200 text-center  text-lg rounded-br-lg">
                                    {{this.tipo_propiedad}}</td>
                            </tr>
                            {{/each}}
                        </tbody>
                        <tbody id="noResult" style="display: none;">
                            <tr>
                                <td colspan="4" class="px-4 py-2 bg-gray-100 border border-gray-600 text-center">No se
                                    encontró ninguna dirección.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            {{!-- Formulario de propiedad --}}
            <div class="flex justify-center px-4 sm:px-6 lg:px-8">
                <div class="w-full sm:w-8/12 md:w-6/12 lg:w-4/12">
                    <h2 class="font-semibold text-2xl pt-1 text-center py-2">Registrar Propiedad</h2>
                    <div class="bg-white p-4 border rounded-lg shadow-lg text-lg">
                        <form action="/altaPropiedad" method="POST">
                            <table class="w-full pt-10">
                                <tbody>
                                    <tr>
                                        <td class="p-2 w-full">
                                            <label for="descripcionPropiedad" class="block text-lg">
                                                <i class="fas fa-map-marker-alt">&nbsp;</i>Dirección</label>
                                            <input type="text" name="descripcionPropiedad" class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 focus:bg-white hover:bg-gray-300" placeholder="Dirección" id="descripcionPropiedad" required value="{{data.descripcionPropiedad}}">
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="p-2 w-full text-lg">
                                            <label for="condomino"><i class="fas fa-user">&nbsp;</i>Condómino</label>
                                            <select id="condomino" name="condomino" class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                                                <option value="" selected></option>
                                                {{#each condomino}}
                                                <option value="{{this.id_usuario}}">{{this.nombre}}</option>
                                                {{/each}}
                                            </select>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="p-2 w-full text-lg">
                                            <label for="tipoPropiedad"><i class="fas fa-city">&nbsp;</i>Tipo de Propiedad</label>
                                            <select id="tipoPropiedad" name="tipoPropiedad" class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                                                {{#each tipoPropiedad}}
                                                {{#isEqual this.id_status 1}}
                                                <option value="{{this.id_tipo_propiedad}}" selected>{{this.descripcion}}</option>
                                                {{else}}
                                                <option value="{{this.id_tipo_propiedad}}">{{this.descripcion}}</option>
                                                {{/isEqual}}
                                                {{/each}}
                                            </select>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="p-2 w-full">
                                            <button id="enviar" type="submit" class="rounded-md bg-gray-500 w-full text-white hover:bg-gray-600 focus:bg-gray-700 font-medium text-xl px-6 py-2 block text-center">Registrar Propiedad</button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <!--Sección para mostrar errores-->
                            {{#if error}}
                            <p class="text-red-500 font-bold text-lg my-3">*{{{error}}}</p>
                            {{/if}}
                        </form>
                        <script>
                            // Mostrar alerta si hay un mensaje de error
                            const errorMessage = '{{error}}'; // Aquí se pasa el mensaje de error desde el backend
                            if (errorMessage) {
                                alert(errorMessage);
                                // Mostrar solo la sección seleccionada
                                document.getElementById('propiedad').classList.remove('hidden');
                            }
                        </script>
                    </div>
                </div>
            </div>

        </div>{{!-- --}}


        <script defer>
            // Obtener los elementos de entrada por su ID
            const precio = document.getElementById('pago');
            const recargo = document.getElementById('recargo');

            // Verificar si los elementos existen antes de trabajar con ellos
            if (precio) {
                // Verificar si el campo ya tiene un valor
                if (precio.value === '') {
                    precio.value = '0.00'; // Solo establece a '0.00' si está vacío
                }

                // Llamar a la función validarInput para el input de precio
                validarInputF(precio);
            }

            if (recargo) {
                // Verificar si el campo ya tiene un valor
                if (recargo.value === '') {
                    recargo.value = '0.00'; // Solo establece a '0.00' si está vacío
                }

                // Llamar a la función validarInput para el input de recargo
                validarInputF(recargo);
            }

            // Función para validar que el input sea un número con hasta dos decimales
            function validarInputF(input) {
                input.addEventListener('input', function () {
                    let value = input.value.replace(/\D/g, ''); // Eliminar cualquier carácter que no sea un dígito
                    let floatValue = (parseFloat(value) / 100).toFixed(2); // Convertir a decimal (dos decimales)

                    // Si no hay valor, establece el valor inicial
                    if (value === '') {
                        input.value = '0.00';
                        return;
                    }

                    // Aplicar formato de número con comas
                    let formattedValue = floatValue.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");

                    input.value = formattedValue;
                });
            }

        </script>

        <!-- Script para el filtro de búsqueda en la primera tabla -->
        <script>
            document.getElementById('search').addEventListener('keyup', function () {
                let filter = this.value.toLowerCase();
                let rows = document.querySelectorAll('#propiedadTable tr');
                let noResult = true;

                rows.forEach(row => {
                    let description = row.cells[1].innerText.toLowerCase();
                    if (description.includes(filter)) {
                        row.style.display = '';
                        noResult = false;
                    } else {
                        row.style.display = 'none';
                    }
                });

                document.getElementById('noResult').style.display = noResult ? '' : 'none';
            });

            $(document).ready(function () {
                $('#condomino').select2({
                    placeholder: "Seleccione un condómino",
                    allowClear: true,
                    language: {
                        noResults: function () {
                            return "No se encontraron resultados";
                        }
                    }
                });
            });

            document.getElementById('contenedorFlecha').addEventListener('click', function (event) {
                event.preventDefault();

                // flechas
                let abajo = document.getElementById('flechaDesc');
                let arriba = document.getElementById('flechaAsc');

                let orden; // Definir la variable "orden"

                // Verificar si está en descendente
                if (abajo.getAttribute('data-order') === 'desc') {
                    // Cambio a orden ascendente
                    abajo.innerHTML = '&uarr;';
                    abajo.setAttribute('data-order', 'asc');
                    orden = 'asc'; // Cambiar el valor de "orden"

                    // Cambiar arriba a descendente
                    arriba.innerHTML = '&darr;';
                    arriba.setAttribute('data-order', 'desc');
                } else {
                    // Cambio a orden descendente
                    abajo.innerHTML = '&darr;';
                    abajo.setAttribute('data-order', 'desc');
                    orden = 'desc'; // Cambiar el valor de "orden"

                    // Cambiar arriba a ascendente
                    arriba.innerHTML = '&uarr;';
                    arriba.setAttribute('data-order', 'asc');
                }

                let tbody = document.getElementById('propiedadTable');
                let filas = Array.from(tbody.getElementsByTagName('tr'));

                // Ordenar las filas en base a la primera columna (FOLIO)
                filas.sort(function (a, b) {
                    let valorA = a.getElementsByTagName('td')[0].innerText;
                    let valorB = b.getElementsByTagName('td')[0].innerText;

                    if (orden === 'asc') {
                        return valorA.localeCompare(valorB, undefined, { numeric: true });
                    } else {
                        return valorB.localeCompare(valorA, undefined, { numeric: true });
                    }
                });

                // Limpiar el tbody y agregar las filas ordenadas
                tbody.innerHTML = '';
                filas.forEach(function (fila) {
                    tbody.appendChild(fila);
                });
            });


        </script>
        <style>
            /* Ajustes de altura */
            .select2-container--default .select2-selection--single {
                height: 3rem;
                /* Ajusta este valor según el tamaño que quieras */
                display: flex;
                align-items: center;
                /* Centra el texto verticalmente */
                position: relative;
                /* Posición relativa para manejar la x */
            }

            .select2-container .select2-selection--single .select2-selection__rendered {
                line-height: 3rem;
                /* Ajusta este valor al mismo valor que el height */
            }

            .select2-container .select2-selection--single .select2-selection__arrow {
                height: 3rem;
                /* Ajusta el ícono del desplegable */
            }

            /* Mover la X al lado derecho */
            .select2-container--default .select2-selection--single .select2-selection__clear {
                position: absolute;
                right: 10px;
                /* Ajusta la distancia del borde derecho */
                top: 50%;
                transform: translateY(-50%);
                cursor: pointer;
                /* Cambia el cursor a pointer para mayor claridad */
            }
        </style>
        <script>
            // Función para mostrar una sección y ocultar las demás
            function mostrarSeccion(seccion) {
                // Ocultar todas las secciones
                document.getElementById('propiedad').classList.add('hidden');
                document.getElementById('tipo').classList.add('hidden');

                // Mostrar solo la sección seleccionada
                document.getElementById(seccion).classList.remove('hidden');
            }
        </script>

</body>

</html>

{{else}}
<div style="display: flex; justify-content: center; align-items: center; height: 100vh;">
    <h1 style="font-size: 3em;">La sesión ha expirado. Por favor, inicie la sesión nuevamente.</h1>
</div>
{{/if}}