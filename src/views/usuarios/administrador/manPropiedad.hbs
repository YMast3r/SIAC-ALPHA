{{#if name}}

<!DOCTYPE html>
<html lang="es">

<head>
    <script src="https://cdn.tailwindcss.com"></script><!--sirve para usar tailwind-->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    {{!-- LIBRERIAS --}}
    <link href="/select2/css/select2.min.css" rel="stylesheet" />
    <script src="/jquery/jquery.min.js"></script>
    <script src="/select2/js/select2.min.js"></script>
</head>

<body class="bg-indigo-200">
    <div>
        <a href="/renderManPropiedad"
            class="font-semibold text-4xl hover:text-gray-400 flex justify-center m-5">Propiedades</a>

        <!-- Primera tabla -->
        <h2 class="font-medium text-2xl mb-4 text-center text-gray-700">Propiedad</h2>

        <!-- Campo de busqueda -->
        <div class="flex justify-center pt-2 mb-0 w-9/12 mx-auto">
            <div class="relative w-full ">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3">
                    <i class="fas fa-search text-gray-500"></i> <!-- Ícono de lupa -->
                </span>
                <input type="text" id="search" placeholder="Buscar descripción en Propiedades..."
                    class=" bg-white border border-gray-200 text-lg placeholder-gray-500 p-2 mb-0 focus:bg-white hover:bg-gray-300 w-full rounded-lg pl-10">
            </div>
        </div>

        <!-- Primera tabla -->
        <div class="w-full">
            <div class="overflow-x-auto  max-h-[40rem] h-80 mb-10 w-9/12 mx-auto shadow-lg ">
                <table class="w-full">
                    <thead class=" sticky top-0">
                        <tr>
                            <th id="contenedorFlecha" style="cursor: pointer;" class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium rounded-tl-lg text-xl">
                                ID PROPIEDAD
                                <span class="inline-flex items-center space-x-1">
                                    <a href="#" id="flechaDesc" data-order="desc">&darr;</a>
                                    <a href="#" id="flechaAsc" data-order="asc">&uarr;</a>
                                </span>
                            </th>
                            <th class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-center text-xl">DESCRIPCIÓN
                            </th>
                            <th class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-center text-xl">CONDÓMINO</th>
                            <th class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium text-center rounded-tr-lg text-xl">
                                TIPO PROPIEDAD</th>

                        </tr>
                    </thead>
                    <tbody id="propiedadTable">
                        {{#each propiedad}}
                        <tr>
                            <td class="px-4 py-2 bg-white text-center  border-b-2 border-gray-200 text-xl rounded-bl-lg">{{this.id_propiedad}}
                            </td>
                            <td class="px-6 py-2 bg-white border-b-2 border-gray-200 text-center text-xl">{{this.descripcion}}
                            </td>
                            <td class="px-4 py-2 bg-white border-b-2 border-gray-200 text-center  text-xl">{{this.condomino}}
                            </td>
                            <td class="px-4 py-2 bg-white border-b-2 border-gray-200 text-center  text-xl rounded-br-lg">
                                {{this.tipo_propiedad}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                    <tbody id="noResult" style="display: none;">
                        <tr>
                            <td colspan="4" class="px-4 py-2 bg-gray-100 border border-gray-600 text-center">No se
                                encontró ninguna descripción</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Segunda tabla -->
        <!-- Campo de búsqueda para la segunda tabla -->
        <div class="flex justify-center pt-2 mb-0 w-9/12 mx-auto">
            <div class="relative w-full {{!-- max-w-3/5 --}}"> 
                <span class="absolute inset-y-0 left-0 flex items-center pl-3">
                    <i class="fas fa-search text-gray-500"></i> <!-- Ícono de lupa -->
                </span>
                <input type="text" id="searchTipoPropiedad" placeholder="Buscar descripción en Tipo Propiedad..."
                    class="bg-white border border-gray-200 text-lg placeholder-gray-500 p-2 mb-0 focus:bg-white hover:bg-gray-300 w-full rounded-lg pl-10">
            </div>
        </div>

        <!-- Tabla -->
        <div class="flex justify-center w-9/12 mx-auto">
            <div class="overflow-x-auto max-h-60 mb-10 w-full {{!-- max-w-3/5 --}}"> 
                <table class="w-full">
                    <thead class="sticky top-0">
                        <tr>
                            <th id="contenedorFlechaTipo" style="cursor: pointer;" class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium rounded-tl-lg  text-lg">
                                TIPO PROPIEDAD
                                <span class="inline-flex items-center space-x-1">
                                    <a href="#" id="flechaDescTipo" data-order="desc">&darr;</a>
                                    <a href="#" id="flechaAscTipo" data-order="asc">&uarr;</a>
                                </span>
                            </th>
                            <th class="px-2 py-1 bg-white border-b-2 border-gray-400 font-medium text-lg text-center">DESCRIPCIÓN
                            </th>
                            <th class="px-6 py-1 bg-white border-b-2 border-gray-400 font-medium  text-lg text-center rounded-tr-lg">
                                PAGO</th>
                        </tr>
                    </thead>
                    <tbody id="tipoPropiedadTable">
                        {{#each tipoPropiedad}}
                        <tr>
                            <td class="px-4 py-2 bg-white text-center border-b-2 border-gray-200 text-lg rounded">{{this.id_tipo_propiedad}}</td>
                            <td class="px-4 py-2 bg-white text-center border-b-2 border-gray-200 text-lg rounded">{{this.descripcion}}</td>
                            <td class="px-4 py-2 bg-white text-center border-b-2 border-gray-200 text-lg rounded">${{this.pago}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                    <tbody id="noResultTipoPropiedad" style="display: none;">
                        <tr>
                            <td colspan="3" class="px-4 py-2 bg-gray-100 border border-gray-600 text-center">No se
                                encontró ninguna descripción</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Formularios encerrados en tablas -->
        <div class="flex justify-center  space-x-56">
            <div {{!-- class="w-1/2" --}}>
                <h2 class="font-semibold text-2xl  pt-10  py-2">Registrar Propiedad</h2>
                <div class="bg-white p-4 border rounded-lg shadow-lg text-lg">
                    <form action="/altaPropiedad" method="POST">
                        <table class="w-full  pt-10">
                            <tbody>
                                <tr>
                                    <td class="p-2 ">
                                        <label for="descripcionPropiedad" class="block  text-lg">Descripción</label>
                                        <input type="text" name="descripcionPropiedad"
                                            class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 focus:bg-white hover:bg-gray-300"
                                            placeholder="Descripción" id="descripcionPropiedad" required
                                            value="{{data.descripcionPropiedad}}">
                                    </td>
                                </tr>
                                <tr>
                                    <td class="p-2  text-lg">
                                        <label for="condomino">Condómino</label>
                                        <select id="condomino" name="condomino"
                                            class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                                            <option value="" selected></option>
                                            {{#each condomino}}
                                            <option value="{{this.id_usuario}}">{{this.nombre}}</option>
                                            {{/each}}
                                        </select>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="p-2  text-lg">
                                        <label for="tipoPropiedad">Tipo Propiedad</label>
                                        <select id="tipoPropiedad" name="tipoPropiedad"
                                            class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                                            {{#each tipoPropiedad}}
                                            {{#isEqual this.id_status 1}}
                                            <option value="{{this.id_tipo_propiedad}}" selected>{{this.descripcion}}
                                            </option>
                                            {{else}}
                                            <option value="{{this.id_tipo_propiedad}}">{{this.descripcion}}</option>
                                            {{/isEqual}}
                                            {{/each}}
                                        </select>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="p-2">
                                        <button type="submit"
                                            class="rounded-md bg-gray-500 w-full text-white hover:bg-gray-600 focus:bg-gray-700 font-medium text-xl px-6 py-2 block text-center">Registrar
                                            Propiedad</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <!--Sección para mostrar errores-->
                        {{#if error}}
                        <p class="text-red-500 font-bold text-lg my-3">*{{{error}}}</p>
                        {{/if}}
                    </form>
                    <script>
                        // Mostrar alerta si hay un mensaje de error
                        const errorMessage = '{{error}}'; // Aquí se pasa el mensaje de error desde el backend
                        if (errorMessage) {
                            alert(errorMessage);
                        }
                    </script>
                </div>
            </div>

            <div {{!-- class="w-1/2" --}}>
                <h2 class="font-semibold text-2xl  pt-10">Registrar tipo propiedad</h2>
                <div class="bg-white p-4 border rounded-lg shadow-lg text-lg">
                    <form action="/altaTipoPropiedad" method="POST">
                        <table class="w-full">
                            <tbody>
                                <tr>
                                    <td class="p-2  text-lg">
                                        <label for="descripcionTipoPro" class="block text-lg">Descripción</label>
                                        <input type="text" name="descripcionTipoPro"
                                            class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 focus:bg-white hover:bg-gray-300"
                                            placeholder="Descripción" id="descripcionTipoPro" required
                                            value="{{data.descripcionTipoPro}}">
                                    </td>
                                </tr>
                                                            <tr>
                                <td class="p-2 ">
                                    <label for="pago" class="block text-lg">Pago</label>
                                    <div class="relative">
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                            class="absolute left-2 top-1/2 transform -translate-y-1/2 text-gray-500" 
                                            width="16" height="16"
                                            viewBox="0 0 24 24" stroke-width="1.5" stroke="#000000" fill="none"
                                            stroke-linecap="round" stroke-linejoin="round">
                                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                            <path d="M16.7 8a3 3 0 0 0 -2.7 -2h-4a3 3 0 0 0 0 6h4a3 3 0 0 1 0 6h-4a3 3 0 0 1 -2.7 -2" />
                                            <path d="M12 3v3m0 12v3" />
                                        </svg>
                                        <input type="tel" name="pago"
                                            class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 pl-6 focus:bg-white hover:bg-gray-300"
                                            placeholder="Pago" id="pago" required value="{{data.pago}}">
                                    </div>
                                </td>
                            </tr>
                                <tr>
                                    <td class="p-2">
                                        <button type="submit"
                                            class="rounded-md bg-gray-500 w-full text-white hover:bg-gray-600 focus:bg-gray-700 font-medium text-xl px-6 py-2 block text-center">Registrar
                                            Pago</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <!--Sección para mostrar errores-->
                        {{#if errorT}}
                        <p class="text-red-500 font-bold text-lg my-3">*{{{errorT}}}</p>
                        {{/if}}
                    </form>
                    <script>
                        // Mostrar alerta si hay un mensaje de error
                        const errorMessageT = '{{errorT}}'; // Aquí se pasa el mensaje de error desde el backend
                        if (errorMessageT) {
                            alert(errorMessageT);
                        }
                    </script>
                </div>
            </div>
        </div>
    </div>

    <!-- Script para el filtro de búsqueda en la primera tabla -->
    <script>
        document.getElementById('search').addEventListener('keyup', function () {
            let filter = this.value.toLowerCase();
            let rows = document.querySelectorAll('#propiedadTable tr');
            let noResult = true;

            rows.forEach(row => {
                let description = row.cells[1].innerText.toLowerCase();
                if (description.includes(filter)) {
                    row.style.display = '';
                    noResult = false;
                } else {
                    row.style.display = 'none';
                }
            });

            document.getElementById('noResult').style.display = noResult ? '' : 'none';
        });

        // Script para el filtro de búsqueda en la segunda tabla
        document.getElementById('searchTipoPropiedad').addEventListener('keyup', function () {
            let filter = this.value.toLowerCase();
            let rows = document.querySelectorAll('#tipoPropiedadTable tr');
            let noResult = true;

            rows.forEach(row => {
                let description = row.cells[1].innerText.toLowerCase();
                if (description.includes(filter)) {
                    row.style.display = '';
                    noResult = false;
                } else {
                    row.style.display = 'none';
                }
            });

            document.getElementById('noResultTipoPropiedad').style.display = noResult ? '' : 'none';
        });



        $(document).ready(function () {
            $('#condomino').select2({
                placeholder: "Seleccione un condómino",
                allowClear: true,
                language: {
                    noResults: function () {
                        return "No se encontraron resultados";
                    }
                }
            });
        });

        // Obtener los elementos de entrada por su ID
        const pago = document.getElementById('pago');
        // Función para validar que el input sea un número con hasta dos decimales
        function validarInputF(input) {
            input.value = '0.00';
            input.addEventListener('input', function () {

                let value = input.value.replace(/\D/g, ''); // Eliminar cualquier carácter que no sea un dígito
                let floatValue = (parseFloat(value) / 100).toFixed(2); // Convertir a decimal (dos decimales)
                
                // Si no hay valor, establece el valor inicial
                if (value === '') {
                    input.value = '0.00';
                    return;
                }

                // Aplicar formato de número con comas
                let formattedValue = floatValue.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");

                input.value = formattedValue;
            });

        }
        // Llamar a la función validarInput para cada input
        validarInputF(pago);

        document.getElementById('contenedorFlecha').addEventListener('click', function (event) {
            event.preventDefault();

            // flechas
            let abajo = document.getElementById('flechaDesc');
            let arriba = document.getElementById('flechaAsc');

            let orden; // Definir la variable "orden"

            // Verificar si está en descendente
            if (abajo.getAttribute('data-order') === 'desc') {
                // Cambio a orden ascendente
                abajo.innerHTML = '&uarr;';
                abajo.setAttribute('data-order', 'asc');
                orden = 'asc'; // Cambiar el valor de "orden"

                // Cambiar arriba a descendente
                arriba.innerHTML = '&darr;';
                arriba.setAttribute('data-order', 'desc');
            } else {
                // Cambio a orden descendente
                abajo.innerHTML = '&darr;';
                abajo.setAttribute('data-order', 'desc');
                orden = 'desc'; // Cambiar el valor de "orden"

                // Cambiar arriba a ascendente
                arriba.innerHTML = '&uarr;';
                arriba.setAttribute('data-order', 'asc');
            }

            let tbody = document.getElementById('propiedadTable');
            let filas = Array.from(tbody.getElementsByTagName('tr'));

            // Ordenar las filas en base a la primera columna (FOLIO)
            filas.sort(function (a, b) {
                let valorA = a.getElementsByTagName('td')[0].innerText;
                let valorB = b.getElementsByTagName('td')[0].innerText;

                if (orden === 'asc') {
                    return valorA.localeCompare(valorB, undefined, { numeric: true });
                } else {
                    return valorB.localeCompare(valorA, undefined, { numeric: true });
                }
            });

            // Limpiar el tbody y agregar las filas ordenadas
            tbody.innerHTML = '';
            filas.forEach(function (fila) {
                tbody.appendChild(fila);
            });
        });

        //segunda funcion
        document.getElementById('contenedorFlechaTipo').addEventListener('click', function (event) {
            event.preventDefault();

            // flechas
            let abajo = document.getElementById('flechaDescTipo');
            let arriba = document.getElementById('flechaAscTipo');

            let orden; // Definir la variable "orden"

            // Verificar si está en descendente
            if (abajo.getAttribute('data-order') === 'desc') {
                // Cambio a orden ascendente
                abajo.innerHTML = '&uarr;';
                abajo.setAttribute('data-order', 'asc');
                orden = 'asc'; // Cambiar el valor de "orden"

                // Cambiar arriba a descendente
                arriba.innerHTML = '&darr;';
                arriba.setAttribute('data-order', 'desc');
            } else {
                // Cambio a orden descendente
                abajo.innerHTML = '&darr;';
                abajo.setAttribute('data-order', 'desc');
                orden = 'desc'; // Cambiar el valor de "orden"

                // Cambiar arriba a ascendente
                arriba.innerHTML = '&uarr;';
                arriba.setAttribute('data-order', 'asc');
            }

            let tbody = document.getElementById('tipoPropiedadTable');
            let filas = Array.from(tbody.getElementsByTagName('tr'));

            // Ordenar las filas en base a la primera columna (FOLIO)
            filas.sort(function (a, b) {
                let valorA = a.getElementsByTagName('td')[0].innerText;
                let valorB = b.getElementsByTagName('td')[0].innerText;

                if (orden === 'asc') {
                    return valorA.localeCompare(valorB, undefined, { numeric: true });
                } else {
                    return valorB.localeCompare(valorA, undefined, { numeric: true });
                }
            });

            // Limpiar el tbody y agregar las filas ordenadas
            tbody.innerHTML = '';
            filas.forEach(function (fila) {
                tbody.appendChild(fila);
            });
        });

        
    </script>

</body>

</html>

{{else}}
<div style="display: flex; justify-content: center; align-items: center; height: 100vh;">
    <h1 style="font-size: 3em;">La sesión ha expirado. Por favor, inicie la sesión nuevamente.</h1>
</div>
{{/if}}