        <!-- Script para el filtro de búsqueda en la primera tabla -->
        <script>
            document.getElementById('search').addEventListener('keyup', function () {
                let filter = this.value.toLowerCase();
                let rows = document.querySelectorAll('#propiedadTable tr');
                let noResult = true;

                rows.forEach(row => {
                    let description = row.cells[1].innerText.toLowerCase();
                    if (description.includes(filter)) {
                        row.style.display = '';
                        noResult = false;
                    } else {
                        row.style.display = 'none';
                    }
                });

                document.getElementById('noResult').style.display = noResult ? '' : 'none';
            });

            // Script para el filtro de búsqueda en la segunda tabla
            document.getElementById('searchTipoPropiedad').addEventListener('keyup', function () {
                let filter = this.value.toLowerCase();
                let rows = document.querySelectorAll('#tipoPropiedadTable tr');
                let noResult = true;

                rows.forEach(row => {
                    let description = row.cells[1].innerText.toLowerCase();
                    if (description.includes(filter)) {
                        row.style.display = '';
                        noResult = false;
                    } else {
                        row.style.display = 'none';
                    }
                });

                document.getElementById('noResultTipoPropiedad').style.display = noResult ? '' : 'none';
            });



            $(document).ready(function () {
                $('#condomino').select2({
                    placeholder: "Seleccione un condómino",
                    allowClear: true,
                    language: {
                        noResults: function () {
                            return "No se encontraron resultados";
                        }
                    }
                });
            });

            // Obtener los elementos de entrada por su ID
            const pago = document.getElementById('pago');
            // Función para validar que el input sea un número con hasta dos decimales
            function validarInputF(input) {
                // Si no hay valor, establece el valor inicial
                if (input.value === '') {
                    input.value = '0.00';
                }
                input.addEventListener('input', function () {

                    let value = input.value.replace(/\D/g, ''); // Eliminar cualquier carácter que no sea un dígito
                    let floatValue = (parseFloat(value) / 100).toFixed(2); // Convertir a decimal (dos decimales)

                    // Si no hay valor, establece el valor inicial
                    if (value === '') {
                        input.value = '0.00';
                        return;
                    }

                    // Aplicar formato de número con comas
                    let formattedValue = floatValue.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");

                    input.value = formattedValue;
                });

            }
            // Llamar a la función validarInput para cada input
            validarInputF(pago);

            document.getElementById('contenedorFlecha').addEventListener('click', function (event) {
                event.preventDefault();

                // flechas
                let abajo = document.getElementById('flechaDesc');
                let arriba = document.getElementById('flechaAsc');

                let orden; // Definir la variable "orden"

                // Verificar si está en descendente
                if (abajo.getAttribute('data-order') === 'desc') {
                    // Cambio a orden ascendente
                    abajo.innerHTML = '&uarr;';
                    abajo.setAttribute('data-order', 'asc');
                    orden = 'asc'; // Cambiar el valor de "orden"

                    // Cambiar arriba a descendente
                    arriba.innerHTML = '&darr;';
                    arriba.setAttribute('data-order', 'desc');
                } else {
                    // Cambio a orden descendente
                    abajo.innerHTML = '&darr;';
                    abajo.setAttribute('data-order', 'desc');
                    orden = 'desc'; // Cambiar el valor de "orden"

                    // Cambiar arriba a ascendente
                    arriba.innerHTML = '&uarr;';
                    arriba.setAttribute('data-order', 'asc');
                }

                let tbody = document.getElementById('propiedadTable');
                let filas = Array.from(tbody.getElementsByTagName('tr'));

                // Ordenar las filas en base a la primera columna (FOLIO)
                filas.sort(function (a, b) {
                    let valorA = a.getElementsByTagName('td')[0].innerText;
                    let valorB = b.getElementsByTagName('td')[0].innerText;

                    if (orden === 'asc') {
                        return valorA.localeCompare(valorB, undefined, { numeric: true });
                    } else {
                        return valorB.localeCompare(valorA, undefined, { numeric: true });
                    }
                });

                // Limpiar el tbody y agregar las filas ordenadas
                tbody.innerHTML = '';
                filas.forEach(function (fila) {
                    tbody.appendChild(fila);
                });
            });

            //segunda funcion
            document.getElementById('contenedorFlechaTipo').addEventListener('click', function (event) {
                event.preventDefault();

                // flechas
                let abajo = document.getElementById('flechaDescTipo');
                let arriba = document.getElementById('flechaAscTipo');

                let orden; // Definir la variable "orden"

                // Verificar si está en descendente
                if (abajo.getAttribute('data-order') === 'desc') {
                    // Cambio a orden ascendente
                    abajo.innerHTML = '&uarr;';
                    abajo.setAttribute('data-order', 'asc');
                    orden = 'asc'; // Cambiar el valor de "orden"

                    // Cambiar arriba a descendente
                    arriba.innerHTML = '&darr;';
                    arriba.setAttribute('data-order', 'desc');
                } else {
                    // Cambio a orden descendente
                    abajo.innerHTML = '&darr;';
                    abajo.setAttribute('data-order', 'desc');
                    orden = 'desc'; // Cambiar el valor de "orden"

                    // Cambiar arriba a ascendente
                    arriba.innerHTML = '&uarr;';
                    arriba.setAttribute('data-order', 'asc');
                }

                let tbody = document.getElementById('tipoPropiedadTable');
                let filas = Array.from(tbody.getElementsByTagName('tr'));

                // Ordenar las filas en base a la primera columna (FOLIO)
                filas.sort(function (a, b) {
                    let valorA = a.getElementsByTagName('td')[0].innerText;
                    let valorB = b.getElementsByTagName('td')[0].innerText;

                    if (orden === 'asc') {
                        return valorA.localeCompare(valorB, undefined, { numeric: true });
                    } else {
                        return valorB.localeCompare(valorA, undefined, { numeric: true });
                    }
                });

                // Limpiar el tbody y agregar las filas ordenadas
                tbody.innerHTML = '';
                filas.forEach(function (fila) {
                    tbody.appendChild(fila);
                });
            });
        </script>
        <script>
            // Función para mostrar una sección y ocultar las demás
            function mostrarSeccion(seccion) {
                // Ocultar todas las secciones
                document.getElementById('propiedad').classList.add('hidden');
                document.getElementById('tipo').classList.add('hidden');

                // Mostrar solo la sección seleccionada
                document.getElementById(seccion).classList.remove('hidden');
            }
        </script>

</body>

</html>

