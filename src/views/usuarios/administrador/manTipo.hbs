{{#if name}}

<!DOCTYPE html>
<html lang="es">

<head>
    <script src="https://cdn.tailwindcss.com"></script><!--sirve para usar tailwind-->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    {{!-- LIBRERIAS --}}
    <link href="/select2/css/select2.min.css" rel="stylesheet" />
    <script src="/jquery/jquery.min.js"></script>
    <script src="/select2/js/select2.min.js"></script>
</head>

<body class="bg-indigo-200">
    {{!-- ---PESTAÑAS--- --}}

    <div>
        <a id="manPaginaTipo" href="/manPaginaTipo"
            class="font-semibold text-4xl hover:text-gray-400 flex justify-center m-5">Página de tipos</a>

        <h1 class="font-medium text-2xl mb-4 text-center text-gray-700">{{titulo}}</h1>

        <!-- Campo de búsqueda -->
        <div class="flex justify-center pt-2 mb-0 w-9/12 lg:w-9/12 mx-auto">
            <div class="relative w-full">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3">
                    <i class="fas fa-search text-gray-500"></i> <!-- Ícono de lupa -->
                </span>
                <input type="text" id="searchTipo" placeholder="Buscar por: {{titulo}}..."
                    class="bg-white border border-gray-200 text-lg placeholder-gray-500 p-2 focus:bg-white hover:bg-gray-300 w-full rounded-lg pl-10">
            </div>
        </div>


        <div class="flex justify-center mx-auto w-9/12 lg:w-9/12">
            <div class="overflow-x-auto max-h-60 w-full border border-gray-200 rounded-lg shadow">
                <table class="w-full text-sm md:text-base lg:text-lg">
                    <thead class="sticky top-0 bg-gray-100">
                        <tr>
                            {{#each tableHeaders}}
                            <th class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium rounded-tl-lg text-xl">
                                {{#if this.sortable}}
                                <a id="{{this.id}}"
                                    href="?orderBy={{this.id}}&orderDirection={{../orderDirection}}"
                                    class="flex items-center justify-center text-center">
                                    {{this.name}}
                                    {{#if this.sortable}}
                                    <span class="ml-2">
                                        {{#isEqual this.orderDirection 'ASC'}}
                                        ↑↓
                                        {{else}}
                                        ↓↑
                                        {{/isEqual}}
                                    </span>
                                    {{/if}}
                                </a>
                                {{else}}
                                <span class="text-center">{{this.name}}</span>
                                {{/if}}
                            </th>
                            {{/each}}
                        </tr>
                    </thead>
                    <tbody id="tipoTable" class="bg-white divide-y divide-gray-200 text-lg">
                        {{#each tableData}}
                        <tr class="hover:bg-gray-100">
                            {{#each ../tableHeaders}}
                            <td id="{{this.name}}" class="px-4 py-2 text-center whitespace-nowrap">
                                {{lookup ../this this.field}}
                            </td>
                            {{/each}}
                        </tr>
                        {{/each}}
                        <!-- Fila para "No se encontró ninguna descripción" -->
                        <tr id="noResult" style="display: none;">
                            <td colspan="{{tableHeaders.length}}"
                                class="px-4 py-4 bg-white text-center font-normal rounded text-lg">
                                No se encontró ningún registro.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        {{!-- Tabla de la Alta de tipo pago --}}

        <!-- Formulario de tipo propiedad -->
        <div class="flex justify-center px-4 sm:px-6 lg:px-8 py-20">
            <div class="w-full sm:w-8/12 md:w-6/12 lg:w-4/12">
                <h2 class="font-semibold text-2xl p-2 text-center">Registrar tipo aquí</h2>
                <div class="bg-white p-4 border rounded-lg shadow-lg text-lg">
                    <form action="/altaTipo" method="POST">
                        <!-- Campo oculto para el tipo -->
                        <input type="hidden" name="tipo" value="{{tipo}}" />

                        <!-- Generación dinámica de campos -->
                        {{#each formFields}}
                        <div class="p-2">
                            <label for="{{this.name}}" class="block text-lg">{{this.label}}</label>
                            {{#isEqual this.name "precio"}}
                            <div class="relative">
                                <!-- Ícono SVG de moneda -->
                                <svg xmlns="http://www.w3.org/2000/svg"
                                    class="absolute left-2 top-1/2 transform -translate-y-1/2 text-gray-500" width="16"
                                    height="16" viewBox="0 0 24 24" stroke-width="1.5" stroke="#000000" fill="none"
                                    stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path
                                        d="M16.7 8a3 3 0 0 0 -2.7 -2h-4a3 3 0 0 0 0 6h4a3 3 0 1 1 0 6h-4a3 3 0 0 1 -2.7 -2" />
                                    <path d="M12 3v3m0 12v3" />
                                </svg>
                                <input id="precio" type="{{this.type}}" name="{{this.name}}"
                                    value="{{this.data}}"
                                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 pl-6 focus:bg-white hover:bg-gray-300"
                                    {{#if this.required}}required{{/if}}>
                            </div>
                            {{else isEqual this.name "recargo"}}
                            <div class="relative">
                                <!-- Ícono SVG de moneda -->
                                <svg xmlns="http://www.w3.org/2000/svg"
                                    class="absolute left-2 top-1/2 transform -translate-y-1/2 text-gray-500" width="16"
                                    height="16" viewBox="0 0 24 24" stroke-width="1.5" stroke="#000000" fill="none"
                                    stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path
                                        d="M16.7 8a3 3 0 0 0 -2.7 -2h-4a3 3 0 0 0 0 6h4a3 3 0 1 1 0 6h-4a3 3 0 0 1 -2.7 -2" />
                                    <path d="M12 3v3m0 12v3" />
                                </svg>
                                <input id="recargo" type="{{this.type}}" name="{{this.name}}"
                                    value="{{this.data}}"
                                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 pl-6 focus:bg-white hover:bg-gray-300"
                                    {{#if this.required}}required{{/if}}>
                            </div>
                            {{else isEqual this.type "select"}}
                            <select name="{{this.name}}" id="{{this.name}}"
                                class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10"
                                {{#if this.required}}required{{/if}}>
                                <option value=""></option>
                                {{#each this.options}}
                                <option value="{{this.value}}">{{this.text}}</option>
                                {{/each}}
                            </select>
                            {{else}}
                            <input id="{{this.name}}" type="{{this.type}}" name="{{this.name}}" value="{{this.data}}"
                                placeholder="{{this.label}}"
                                class="border border-gray-200 w-full text-lg p-2 focus:bg-white hover:bg-gray-300" {{#if
                                this.required}}required{{/if}}>
                            {{/isEqual}}
                        </div>
                        {{/each}}

                        <!-- Botón para registrar -->
                        <button id="registrarTipo" type="submit"
                            class="rounded-md bg-gray-500 w-full text-white hover:bg-gray-600 focus:bg-gray-700 font-medium text-xl px-6 py-3 block mt-4 mb-2 text-center">
                            Registrar
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Popup de error -->
        <div id="info-popup" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden">
            <div class="bg-white rounded-lg p-6 shadow-lg">
                <div class="mb-4">
                    <p>Algo ha salido mal, intentalo de nuevo</p>
                </div>
                <div class="flex justify-end">
                    <button id="close-modal"
                        class="px-4 py-2 bg-red-500 text-white rounded hover:bg-red-600">Cerrar</button>
                </div>
            </div>
        </div>

        <script>
            document.getElementById('searchTipo').addEventListener('keyup', function () {
                let filter = this.value.toLowerCase();
                let rows = document.querySelectorAll('#tipoTable tr');
                let noResult = true;

                rows.forEach(row => {
                    // Solo ocultar las filas que no son el mensaje de "noResult"
                    if (row.id !== 'noResult') {
                        let description = row.cells[1].innerText.toLowerCase(); // Ajusta el índice de la celda si es necesario
                        if (description.includes(filter)) {
                            row.style.display = '';
                            noResult = false;
                        } else {
                            row.style.display = 'none';
                        }
                    }
                });

                // Mostrar o ocultar el mensaje de "No se encontró ninguna descripción"
                document.getElementById('noResult').style.display = noResult ? '' : 'none';
            });
        </script>
        <script>
            // Obtener los elementos de entrada por su ID
            const precio = document.getElementById('precio');
            const recargo = document.getElementById('recargo');
            
            // Verificar si los elementos existen antes de trabajar con ellos
            if (precio) {
                // Verificar si el campo ya tiene un valor
                if (precio.value === '') {
                    precio.value = '0.00'; // Solo establece a '0.00' si está vacío
                }

                // Llamar a la función validarInput para el input de precio
                validarInputF(precio);
            }

            if (recargo) {
                // Verificar si el campo ya tiene un valor
                if (recargo.value === '') {
                    recargo.value = '0.00'; // Solo establece a '0.00' si está vacío
                }

                // Llamar a la función validarInput para el input de recargo
                validarInputF(recargo);
            }

            // Función para validar que el input sea un número con hasta dos decimales
            function validarInputF(input) {
                input.addEventListener('input', function () {
                    let value = input.value.replace(/\D/g, ''); // Eliminar cualquier carácter que no sea un dígito
                    let floatValue = (parseFloat(value) / 100).toFixed(2); // Convertir a decimal (dos decimales)

                    // Si no hay valor, establece el valor inicial
                    if (value === '') {
                        input.value = '0.00';
                        return;
                    }

                    // Aplicar formato de número con comas
                    let formattedValue = floatValue.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");

                    input.value = formattedValue;
                });
            }

        </script>
        <script>
            // Mostrar mensaje de error personalizado si hay un mensaje de error
            const errorMessage = '{{errorT}}'; // Asumiendo que 'errorT' contiene el mensaje de error desde el backend
            if (errorMessage) {
                const errorContainer = document.createElement('div');
                errorContainer.setAttribute('role', 'alert');
                errorContainer.innerHTML = `
        <div class="border border-t-0 border-red-400 rounded-b bg-red-100 px-4 py-3 text-red-700">
            <p>${errorMessage}</p>
        </div>
    `;
                document.querySelector('form').prepend(errorContainer); // Agregar el mensaje de error al formulario

                // Mostrar el popup solo si hay error
                const popup = document.getElementById('info-popup');
                popup.classList.remove('hidden'); // Mostrar el popup si hay error
            }

            // Cerrar el popup cuando se haga clic en "Cancelar"
            document.getElementById('close-modal').addEventListener('click', function () {
                const popup = document.getElementById('info-popup');
                popup.classList.add('hidden'); // Ocultar el popup
            });

            // Cerrar el popup cuando se haga clic en "Confirmar"
            document.getElementById('confirm-button').addEventListener('click', function () {
                const popup = document.getElementById('info-popup');
                popup.classList.add('hidden'); // Ocultar el popup
            });

        </script>
        <script>
            $(document).ready(function () {
                $('#tipo_incidencia').select2({
                    placeholder: "Seleccione un tipo incidencia",
                    allowClear: true,
                    language: {
                        noResults: function () {
                            return "No se encontraron resultados";
                        }
                    }
                });
            });
        </script>
        <style>
            /* Ajustes de altura */
            .select2-container--default .select2-selection--single {
                height: 3rem;
                /* Ajusta este valor según el tamaño que quieras */
                display: flex;
                align-items: center;
                /* Centra el texto verticalmente */
                position: relative;
                /* Posición relativa para manejar la x */
            }

            .select2-container .select2-selection--single .select2-selection__rendered {
                line-height: 3rem;
                /* Ajusta este valor al mismo valor que el height */
            }

            .select2-container .select2-selection--single .select2-selection__arrow {
                height: 3rem;
                /* Ajusta el ícono del desplegable */
            }

            /* Mover la X al lado derecho */
            .select2-container--default .select2-selection--single .select2-selection__clear {
                position: absolute;
                right: 10px;
                /* Ajusta la distancia del borde derecho */
                top: 50%;
                transform: translateY(-50%);
                cursor: pointer;
                /* Cambia el cursor a pointer para mayor claridad */
            }
        </style>
</body>

</html>

{{else}}
<div style="display: flex; justify-content: center; align-items: center; height: 100vh;">
    <h1 style="font-size: 3em;">La sesión ha expirado. Por favor, inicie la sesión nuevamente.</h1>
</div>
{{/if}}