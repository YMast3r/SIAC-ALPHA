{{#if name}}
<!DOCTYPE html>
<html lang="es">

<head>
    <script src="https://cdn.tailwindcss.com"></script><!-- sirve para usar tailwind -->
</head>

<body class="bg-indigo-300">

    <!-- Sección de Datos -->
    <div>
        <a href="/renderIncidencia">
            <h1 class="font-semibold text-4xl flex justify-center m-5">Incidencia</h1>
        </a>
        <div class="flex justify-center m-5">
            <div class="overflow-x-auto relative w-1/2 border-2 border-gray-300 rounded-lg shadow-lg">
                <table class="w-full rounded-lg overflow-hidden">
                    <thead>
                        <tr>
                            <th class="px-4 py-2 bg-white border-b-2 border-gray-400 font-medium rounded-tl-lg">Id</th>
                            <th class="px-4 py-2 bg-white border-b-2 border-gray-400 font-medium">Nombre</th>
                            <th class="px-4 py-2 bg-white border-b-2 border-gray-400 font-medium">Correo</th>
                            <th class="px-4 py-2 bg-white border-b-2 border-gray-400 font-medium">telefono</th>
                            <th class="px-4 py-2 bg-white border-b-2 border-gray-400 font-medium rounded-tr-lg">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each usuario}}
                        <tr>
                            <td class="px-4 py-2 bg-white text-center border-b-2 border-gray-200">{{this.id}}</td>
                            <td class="px-4 py-2 bg-white border-b-2 border-gray-200">{{this.nombre}}</td>
                            <td class="px-4 py-2 bg-white border-b-2 border-gray-200">{{this.correo_electronico}}</td>
                            <td class="px-4 py-2 bg-white border-b-2 border-gray-200">{{this.telefono}}</td>
                            <td class="px-4 py-2 bg-white border-b-2 border-gray-200">{{this.status}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Sección de Incidencias -->
    <div class="flex justify-center pt-2 mb-0">
        <div class="relative w-1/2">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3">
                <i class="fas fa-search text-gray-500"></i> <!-- Ícono de lupa -->
            </span>
            <input type="text" id="buscarAsunto" onkeyup="filtrarTabla()" placeholder="Buscar por asunto"class=" bg-white border border-gray-200 text-lg placeholder-gray-500 p-2 mb-0 focus:bg-white hover:bg-gray-300 w-full rounded-lg pl-10">
        </div>
    </div>
        <div class="flex justify-center">
            <div class="overflow-x-auto max-h-60 border-2 border-gray-300 rounded-lg shadow-lg relative w-1/2">
                <table id="tablaIncidencias" class="w-full rounded-lg overflow-hidden">
                    <thead>
                        <tr>
                            <th class="px-4 py-4 bg-white border-b-2 border-gray-400 font-medium rounded-tl-lg">
                            <div id="contenedorFlecha" style="display: inline; cursor: pointer;">
                                Folio
                                <a href="#" id="flechaDesc" data-order="desc">&darr;</a>
                                <a href="#" id="flechaAsc" data-order="asc">&uarr;</a>
                            </div>
                            </th>                             
                            <th class="px-4 py-2 bg-white border-b-2 border-gray-400 font-medium">Asunto</th>
                            <th class="px-4 py-2 bg-white border-b-2 border-gray-400 font-medium">Tipo</th>
                            <th class="px-4 py-2 bg-white border-b-2 border-gray-400 font-medium">Status</th>
                            <th class="px-4 py-2 bg-white border-b-2 border-gray-400 font-medium">Fecha</th>
                            <th class="px-4 py-2 bg-white border-b-2 border-gray-400 font-medium rounded-tr-lg">Evidencia</th>
                        </tr>
                    </thead>
                    <tbody id="condominoTabla">
                        {{#each datos}}
                        <tr>
                            <td class="px-4 py-2 bg-white text-center border-b-2 border-gray-200">{{this.folio}}</td>
                            <td class="px-4 py-2 bg-white border-b-2 border-gray-200">{{this.asunto}}</td>
                            <td class="px-4 py-2 bg-white border-b-2 border-gray-200">{{this.tipo}}</td>
                            <td class="px-4 py-2 bg-white border-b-2 border-gray-200">{{this.status}}</td>
                            <td class="px-4 py-2 bg-white border-b-2 border-gray-200">{{this.fecha}}</td>
                            <td class="px-4 py-2 bg-white border-b-2 border-gray-200">
                                {{#if this.evidencia}}
                                <img src="{{this.evidencia}}" alt="Evidencia" class="w-20 h-20 object-cover rounded-sm"
                                    onclick="mostrarImagen(this.src)">
                                {{else}}
                                Sin evidencia
                                {{/if}}
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
        <div class="flex justify-center m-5">
            <h1 class="font-semibold text-4xl flex justify-center m-5">Alta</h1>
        </div>
        <!-- Formulario para agregar incidencia -->
        <div class="mx-auto my-8 p-4 bg-white w-full sm:w-5/6 md:w-4/6 lg:w-2/3 xl:w-1/3 border rounded-lg shadow-lg">
            <form action="/altaIncidencia" method="POST" enctype="multipart/form-data">
                <label for="asunto">Asunto</label>
                <input type="text" id="asunto" name="asunto" required placeholder="Asunto"
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">

                <label for="descripcion">Descripción</label>
                <br>
                <textarea name="descripcion" id="descripcion" placeholder="Descripción"
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10"></textarea>
                <br>

                <label for="tipo">Tipo</label>
                <select id="tipo" name="tipo"
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                    {{#each tipos}}
                    <option value="{{this.id_tipo_incidencia}}">{{this.descripcion}}</option>
                    {{/each}}
                </select>

                <label for="fecha">Fecha</label>
                <input type="date" id="fecha" name="fecha" required
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">


                <label for="imagen"><i class="fas fa-image"></i> Subir imagen</label>
                <input type="file" id="imagen" name="imagen" accept=".png, .jpg, .jpeg, .pdf"
                    class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300">

                <div class="flex justify-center">
                    <button type="submit"
                        class="bg-gray-600 text-white px-4 py-2 rounded-md hover:bg-gray-800 focus:bg-gray-900">Agregar
                        Incidencia</button>
                </div>

                <!--Sección para mostrar errores-->
                {{#if error}}
                <p class="text-red-500 font-bold text-lg my-3">*{{{error}}}</p>
                {{/if}}

            </form>
            <script>
                // Mostrar alerta si hay un mensaje de error
                const errorMessage = '{{error}}'; // Aquí se pasa el mensaje de error desde el backend
                if (errorMessage) {
                    alert(errorMessage);
                }
            </script>
        </div>
    </div>
    <script src="fecha.js"></script>
    <script>
        document.getElementById("buscarAsunto").addEventListener("input", function (event) {
            let valor = event.target.value;
            // Permitir solo letras, números y espacios
            event.target.value = valor.replace(/[^a-zA-Z0-9 ]/g, '');
        });

        function filtrarTabla() {
            let input = document.getElementById("buscarAsunto");
            let filtro = input.value.toLowerCase();
            let tabla = document.getElementById("tablaIncidencias");
            let filas = tabla.getElementsByTagName("tr");

            // Elimina cualquier mensaje anterior de "No se encontró ningún asunto"
            let filasNoEncontrado = tabla.querySelectorAll(".fila-no-encontrado");
            filasNoEncontrado.forEach(fila => fila.remove());

            let encontrado = false;

            for (let i = 1; i < filas.length; i++) {
                let celdaAsunto = filas[i].getElementsByTagName("td")[1];
                if (celdaAsunto) {
                    let asuntoTexto = celdaAsunto.textContent || celdaAsunto.innerText;
                    if (asuntoTexto.toLowerCase().indexOf(filtro) > -1) {
                        filas[i].style.display = "";
                        encontrado = true;
                    } else {
                        filas[i].style.display = "none";
                    }
                }
            }

            if (!encontrado) {
                let filaNoEncontrado = document.createElement("tr");
                filaNoEncontrado.className = "fila-no-encontrado"; // Clase identificadora
                let celda = document.createElement("td");
                celda.colSpan = 7;
                celda.className = "px-4 py-2 bg-white border border-gray-600 text-center";
                celda.textContent = "No se encontró ningún asunto";
                filaNoEncontrado.appendChild(celda);
                tabla.getElementsByTagName("tbody")[0].appendChild(filaNoEncontrado);
            }
        }

        document.getElementById('contenedorFlecha').addEventListener('click', function (event) {
            event.preventDefault();

            // flechas
            let abajo = document.getElementById('flechaDesc');
            let arriba = document.getElementById('flechaAsc');

            let orden; // Definir la variable "orden"

            // Verificar si está en descendente
            if (abajo.getAttribute('data-order') === 'desc') {
                // Cambio a orden ascendente
                abajo.innerHTML = '&uarr;';
                abajo.setAttribute('data-order', 'asc');
                orden = 'asc'; // Cambiar el valor de "orden"

                // Cambiar arriba a descendente
                arriba.innerHTML = '&darr;';
                arriba.setAttribute('data-order', 'desc');
            } else {
                // Cambio a orden descendente
                abajo.innerHTML = '&darr;';
                abajo.setAttribute('data-order', 'desc');
                orden = 'desc'; // Cambiar el valor de "orden"

                // Cambiar arriba a ascendente
                arriba.innerHTML = '&uarr;';
                arriba.setAttribute('data-order', 'asc');
            }

            let tbody = document.getElementById('condominoTabla');
            let filas = Array.from(tbody.getElementsByTagName('tr'));

            // Ordenar las filas en base a la primera columna (FOLIO)
            filas.sort(function (a, b) {
                let valorA = a.getElementsByTagName('td')[0].innerText;
                let valorB = b.getElementsByTagName('td')[0].innerText;

                if (orden === 'asc') {
                    return valorA.localeCompare(valorB, undefined, { numeric: true });
                } else {
                    return valorB.localeCompare(valorA, undefined, { numeric: true });
                }
            });

            // Limpiar el tbody y agregar las filas ordenadas
            tbody.innerHTML = '';
            filas.forEach(function (fila) {
                tbody.appendChild(fila);
            });
        });
    </script>
    <script src="imagen.js"></script>
</body>

</html>
{{else}}
<div style="display: flex; justify-content: center; align-items: center; height: 100vh;">
    <h1 style="font-size: 3em;">La sesión ha expirado. Por favor, inicie la sesión nuevamente.</h1>
</div>
{{/if}}
    