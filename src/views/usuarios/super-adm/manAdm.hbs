{{#if name}}
<!DOCTYPE html>
<html lang="es">
<head>
    <script src="https://cdn.tailwindcss.com"></script><!--sirve para usar tailwind-->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <style>
        .hidden { display: none; }
    </style>
</head>
<body class="bg-indigo-200">
    <div>
        <a id="renderAdm" href="/renderAdm" class="font-semibold text-4xl flex justify-center m-5">Administradores</a>

        <!-- Campo de búsqueda -->
        <div class="flex justify-center pt-2 mb-0 "></div>
            <div class="relative w-3/4 mx-auto">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3">
                    <i class="fas fa-search text-gray-500"></i> <!-- Ícono de lupa -->
                </span>
                <input type="text" id="searchInput" placeholder="Buscar por nombre..." class="bg-white border border-gray-200 text-lg placeholder-gray-500 p-2 mb-0 focus:bg-white hover:bg-gray-300 w-full rounded-lg pl-10">
            </div>
        </div>

        <div class="flex justify-center">
            <div class="overflow-x-auto relative w-3/4 rounded-lg shadow-lg max-h-80">
                <table class="w-full rounded-lg" id="adminTable">
                    <thead  class="sticky top-0">
                        <tr>
                            <th id="contenedorFlecha" style="cursor: pointer;" class="px-4 {{!-- py-4 --}} bg-white border-b-2 border-gray-400 text-xl font-medium rounded-tl-lg ">
                            <span class="inline-flex items-center space-x-1">
                                <p> ID </p>
                                {{!-- &nbsp; --}}
                                <a href="#" id="flechaDesc" data-order="desc">&darr;</a>
                                <a href="#" id="flechaAsc" data-order="asc">&uarr;</a>
                            </span>
                            </th>                             
                            <th class="px-6 py-2 bg-white border-b-2 border-gray-400 text-xl font-medium">NOMBRE</th>
                            <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-xl font-medium">CORREO</th>
                            <th class="px-8 py-2 bg-white border-b-2 border-gray-400 text-xl font-medium">TELÉFONO</th>
                            <th class="px-4 py-2 bg-white border-b-2 border-gray-400 text-xl font-medium">ESTADO</th>
                            <th class="px-2 py-2 bg-white border-b-2 border-gray-400 text-xl font-medium  rounded-tr-lg">EDITAR</th>
                        </tr>
                    </thead>
                    <tbody id="AdminTabla">
                        {{#each datos}}
                        <tr>
                            <td class="px-4 py-2 bg-white text-center border-b-2 border-gray-200">{{this.id}}</td>
                            <td class="px-4 py-2 bg-white text-center border-b-2 border-gray-200">{{this.nombre}}</td>
                            <td class="px-4 py-2 bg-white text-center border-b-2 border-gray-200">{{this.correo_electronico}}</td>
                            <td class="px-4 py-2 bg-white text-center border-b-2 border-gray-2000">{{this.telefono}}</td>
                            <td class="px-4 py-2 bg-white text-center border-b-2 border-gray-200">{{this.status}}</td>
                            <td class="px-4 py-2 bg-white border-b-2 border-gray-200 text-center"><a id="{{id}}" href="/ediAdm{{id}}"><svg class="h-8 w-10 text-black text-gray-600 mx-auto" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">  <path stroke="none" d="M0 0h24v24H0z"/>  <path d="M4 20h4l10.5 -10.5a1.5 1.5 0 0 0 -4 -4l-10.5 10.5v4" />  <line x1="13.5" y1="6.5" x2="17.5" y2="10.5" /></svg></a></td>
                        </tr>
                        {{/each}}
                        <tr id="noResultsRow" class="hidden">
                            <td colspan="6" class="px-4 py-4 bg-white text-center font-normal rounded text-lg">No se encontró el nombre</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
            <div class="card">
                {{#if modificar}}
                    <h2  class="font-semibold font-mono text-4xl flex justify-center m-5">Modifica administrador<h2/>
                {{else}}
                    <h2  class="font-semibold text-4xl flex justify-center m-5">Alta de administrador<h2/> 
                {{/if}}
            <div class="mx-auto my-8 p-4 bg-white w-full sm:w-5/6 md:w-4/6 lg:w-2/3 xl:w-1/2 border rounded-lg shadow-lg">
                <div class="card-body">
                    <form action="/manipulaAdm" method="POST" onsubmit="return telefonoValid() && correoValid()">
                    
                        <label for="nombre"><i class="fas fa-user"></i> Usuario</label>
                        <div class="relative">
                            {{#if modificar}}
                                <input type="text" name="nombre" class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10" placeholder="Usuario" id="nombre" pattern="[a-zA-Z-s]+" title="No se permiten acentos ni caracteres especiales" value="{{usuario.nombre}}" readonly>
                            {{else}}
                                <input type="text" name="nombre" class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10" placeholder="Usuario" id="nombre" pattern="[a-zA-Z-s]+" title="No se permiten acentos ni caracteres especiales" value="{{usuario.nombre}}" required>
                            {{/if}}  
                        </div>

                        
                        <div class="form-group">
                            <label for="correo_electronico"><i class="fas fa-envelope"></i> Correo Electrónico</label>
                            <div class="relative">
                                <input type="email" name="correo_electronico" class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10" placeholder="Correo electrónico" id="correo_electronico" value="{{usuario.correo_electronico}}" required>
                            </div> 
                            <small id="correoError" class="form-text text-danger text-red-600"></small>
                        </div>
                        
                        <!-- Campo para ingresar el teléfono -->
                        <div class="form-group">
                            <label for="telefono"><i class="fas fa-phone"></i> Teléfono</label>
                            <div class="relative">
                                <input type="tel" name="telefono" class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10" id="telefono" placeholder="Teléfono (ej. 449 223 9955)" value="{{usuario.telefono}}" required>
                            </div>    
                                <small id="telefonoError" class="form-text text-danger text-red-600"></small>
                        </div>

                        <label for="password"><i class="fas fa-lock"></i> Contraseña</label>
                        <div class="relative">
                            {{#if modificar}}
                                <input type="password" name="password" class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10" placeholder="Nueva contraseña (si no desea modificar la contraseña, déjelo en blanco)" id="passwordEdi" value="{{usuario.password}}">
                            {{else}}
                                <input type="password" name="password" class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10" placeholder="Contraseña" id="password" value="{{usuario.password}}" required>
                            {{/if}}
                            <div class="absolute right-2 top-1/2 transform -translate-y-1/2">
                                {{!-- ojo abierto --}}
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-eye" width="30" height="30" viewBox="0 0 24 24" stroke-width="1.5" stroke="#000000" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                        <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
                                        <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" />
                                    </svg>

                                {{!-- ojo cerrado --}}
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-eye-closed" width="30" height="30" viewBox="0 0 24 24" stroke-width="1.5" stroke="#000000" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                        <path d="M21 9c-2.4 2.667 -5.4 4 -9 4c-3.6 0 -6.6 -1.333 -9 -4" />
                                        <path d="M3 15l2.5 -3.8" />
                                        <path d="M21 14.976l-2.492 -3.776" />
                                        <path d="M9 17l.5 -4" />
                                        <path d="M15 17l-.5 -4" />
                                </svg>
                            </div>
                        </div>

                        <label for="confPassword"><i class="fas fa-lock"></i> Confirmar Contraseña</label>        
                        <div class="relative">
                            {{#if modificar}}
                                <input type="password" name="confPassword"  id="confPassword" placeholder="Confirmar contraseña nueva" class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10" value="{{usuario.confPassword}}">
                            {{else}}
                                <input type="password" name="confPassword"  id="confPasswordEdi" placeholder="Confirmar contraseña" class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10" value="{{usuario.confPassword}}" required >
                            {{/if}}
                            <div class="absolute right-2 top-1/2 transform -translate-y-1/2">
                                {{!-- ojo abierto --}}
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-eye" width="30" height="30" viewBox="0 0 24 24" stroke-width="1.5" stroke="#000000" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                    <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
                                    <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" />
                                </svg>

                                {{!-- ojo cerrado --}}
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-eye-closed" width="30" height="30" viewBox="0 0 24 24" stroke-width="1.5" stroke="#000000" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                    <path d="M21 9c-2.4 2.667 -5.4 4 -9 4c-3.6 0 -6.6 -1.333 -9 -4" />
                                    <path d="M3 15l2.5 -3.8" />
                                    <path d="M21 14.976l-2.492 -3.776" />
                                    <path d="M9 17l.5 -4" />
                                    <path d="M15 17l-.5 -4" />
                                </svg>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="status"><i class="fas fa-user"></i> Estado</label>
                            <select id="status" name="status" class="border border-gray-200 w-full text-lg placeholder-gray-500 p-2 my-2 focus:bg-white hover:bg-gray-300 pr-10">
                                {{#each estados}}
                                    {{#isEqual this.id_status this.correcto}}
                                        <option value="{{this.id_status}}" selected>{{this.descripcion}}</option>
                                    {{else}}
                                        <option value="{{this.id_status}}">{{this.descripcion}}</option>
                                    {{/isEqual}}
                                {{/each}}
                            </select>
                        </div>

                        {{#if error}}
                            <h4 style="text-align: center; color: red;">*{{{error}}}</h4>
                        {{/if}}

                        <button id="enviar" type="submit" class=" rounded-md bg-gray-500 w-full  text-white hover:bg-gray-600 focus:bg-gray-700 font-medium text-base px-6 py-3 block mt-4 mb-2 text-center " >Enviar</button>
                    </form>
                    <script>
                        // Mostrar alerta si hay un mensaje de error
                        const errorMessage = '{{error}}'; // Aquí se pasa el mensaje de error desde el backend
                        if (errorMessage) {
                            alert(errorMessage);
                        }
                    </script>
                </div>
            </div>
        </div>
        </div>
        <script>
            document.getElementById('searchInput').addEventListener('input', function() {
                var filter = this.value.toLowerCase();
                var rows = document.querySelectorAll('#adminTable tbody tr:not(#noResultsRow)');
                var noResultsRow = document.getElementById('noResultsRow');
                var hasResults = false;

                rows.forEach(function(row) {
                    var nameCell = row.querySelector('td:nth-child(2)');
                    var name = nameCell.textContent.toLowerCase();
                    if (name.includes(filter)) {
                        row.classList.remove('hidden');
                        hasResults = true;
                    } else {
                        row.classList.add('hidden');
                    }
                });

                noResultsRow.classList.toggle('hidden', hasResults || filter === "");
            });

            document.getElementById('contenedorFlecha').addEventListener('click', function (event) {
            event.preventDefault();

            // flechas
            let abajo = document.getElementById('flechaDesc');
            let arriba = document.getElementById('flechaAsc');

            let orden; // Definir la variable "orden"

            // Verificar si está en descendente
            if (abajo.getAttribute('data-order') === 'desc') {
                // Cambio a orden ascendente
                abajo.innerHTML = '&uarr;';
                abajo.setAttribute('data-order', 'asc');
                orden = 'asc'; // Cambiar el valor de "orden"

                // Cambiar arriba a descendente
                arriba.innerHTML = '&darr;';
                arriba.setAttribute('data-order', 'desc');
            } else {
                // Cambio a orden descendente
                abajo.innerHTML = '&darr;';
                abajo.setAttribute('data-order', 'desc');
                orden = 'desc'; // Cambiar el valor de "orden"

                // Cambiar arriba a ascendente
                arriba.innerHTML = '&uarr;';
                arriba.setAttribute('data-order', 'asc');
            }

            let tbody = document.getElementById('AdminTabla');
            let filas = Array.from(tbody.getElementsByTagName('tr'));

            // Ordenar las filas en base a la primera columna (FOLIO)
            filas.sort(function (a, b) {
                let valorA = a.getElementsByTagName('td')[0].innerText;
                let valorB = b.getElementsByTagName('td')[0].innerText;

                if (orden === 'asc') {
                    return valorA.localeCompare(valorB, undefined, { numeric: true });
                } else {
                    return valorB.localeCompare(valorA, undefined, { numeric: true });
                }
            });

            // Limpiar el tbody y agregar las filas ordenadas
            tbody.innerHTML = '';
            filas.forEach(function (fila) {
                tbody.appendChild(fila);
            });
        });
        </script>
        <script src="telefono.js"></script>    
        <script src="correo.js"></script>
        <script src="ojo.js"></script>    
    </body>
    </html>

{{else}}
    <div style="display: flex; justify-content: center; align-items: center; height: 100vh;">
        <h1 style="font-size: 3em;">La sesión ha expirado. Por favor, inicie la sesión nuevamente.</h1>
    </div>
{{/if}}
